---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { externalPublicationLinks, getPublications, getPublicationSummary, isVerifiedPublicationText } from '../../utils/publications';
import { sitePath } from '../../utils/site';

export async function getStaticPaths() {
  const publications = await getPublications();
  return publications.map((publication) => ({ params: { slug: publication.slug }, props: { publication } }));
}

const { publication } = Astro.props;
const { data } = publication;
const links = externalPublicationLinks(publication);
const summary = getPublicationSummary(publication);
const verifiedResults = data.keyResults.filter((result: string) => isVerifiedPublicationText(result));
const citation = data.citation || `${data.authors.join(', ')}. (${data.year}). ${data.title}. ${data.venue}.`;
const related = (await getPublications()).filter((item) => item.slug !== publication.slug && item.data.tags.some((tag) => data.tags.includes(tag))).slice(0, 3);
const articleJsonLd = {
  '@context': 'https://schema.org', '@type': 'ScholarlyArticle',
  headline: data.title, abstract: isVerifiedPublicationText(data.abstract) ? data.abstract : summary,
  datePublished: String(data.year), author: data.authors.map((name: string) => ({ '@type': 'Person', name })),
  isPartOf: { '@type': 'Periodical', name: data.venue }, keywords: data.tags.join(', '),
  url: new URL(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`, Astro.site || Astro.url).toString(), image: data.image ? new URL(data.image, Astro.site || Astro.url).toString() : undefined,
};
---

<BaseLayout title={`${data.title} | Adarsh Bhandary Panambur`} description={summary} image={data.image} type="article" jsonLd={articleJsonLd}>
  <Nav />
  <main id="main-content">
    <article>
      <header class="paper-hero">
        <div class="paper-grid grid-field" aria-hidden="true"></div>
        <div class="shell paper-header-inner">
          <a href={sitePath('publications/')} class="back-link">← PUBLICATION ARCHIVE</a>
          <div class="paper-header-grid">
            <div>
              <p class="section-kicker">{data.type} / {data.year} / {data.status || 'Research output'}</p>
              <h1>{data.title}</h1>
              <p class="paper-authors">{data.authors.join(' · ')}</p>
            </div>
            <aside><span>VENUE</span><strong>{data.venue}</strong><span>TOPICS</span><p>{data.tags.join(' / ')}</p></aside>
          </div>
          {links.length > 0 && <div class="paper-links">{links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>}
        </div>
      </header>

      <div class="shell paper-layout">
        <div class="paper-content">
          {data.image && <figure class="paper-figure"><img src={data.image} alt={data.imageAlt || data.title} /><figcaption>{data.figureCaption}{data.sourceUrl && <> <a href={data.sourceUrl} target="_blank" rel="noopener noreferrer">{data.sourceLabel || 'Source'} ↗</a></>}</figcaption></figure>}
          <section><span>00 / OVERVIEW</span><h2>Scientific summary</h2><p>{summary}</p></section>
          {isVerifiedPublicationText(data.abstract) && <section><span>01 / ABSTRACT</span><h2>Abstract</h2><p>{data.abstract}</p></section>}
          <section><span>02 / RELEVANCE</span><h2>Why it matters</h2><p>{data.relevance}</p></section>
          {isVerifiedPublicationText(data.contribution) && <section><span>03 / CONTRIBUTION</span><h2>Contribution</h2><p>{data.contribution}</p></section>}
          {isVerifiedPublicationText(data.method) && <section><span>04 / METHOD</span><h2>Method overview</h2><p>{data.method}</p></section>}
          {verifiedResults.length > 0 && <section><span>05 / FINDINGS</span><h2>Key findings</h2><ul>{verifiedResults.map((result: string) => <li>{result}</li>)}</ul></section>}
          <section><span>06 / REFERENCE</span><h2>Citation</h2><div class="citation-box"><p>{citation}</p>{isVerifiedPublicationText(data.bibtex) && <pre><code>{data.bibtex}</code></pre>}</div></section>
        </div>
        <aside class="paper-index"><p>ON THIS PAGE</p><a href="#main-content">Overview</a>{isVerifiedPublicationText(data.abstract) && <span>Abstract</span>}<span>Why it matters</span>{isVerifiedPublicationText(data.method) && <span>Method</span>}<span>Citation</span></aside>
      </div>
    </article>

    {related.length > 0 && <section class="related-papers"><div class="shell"><p class="section-kicker">CONNECTED RESEARCH</p><h2>Related publications</h2><div>{related.map((item) => <PublicationCard publication={item} compact />)}</div></div></section>}
  </main>
  <Footer />
</BaseLayout>

<style>
  .paper-hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); padding: 8rem 0 4.5rem; background: radial-gradient(circle at 75% 35%,rgba(36,124,255,.17),transparent 28rem),#050810; }.paper-grid { position: absolute; inset: 0; opacity: .3; }.paper-header-inner { position: relative; }.back-link { color: #8397af; font: .58rem ui-monospace,monospace; letter-spacing: .1em; }.back-link:hover { color: var(--cyan); }.paper-header-grid { display: grid; grid-template-columns: minmax(0,1fr) 18rem; gap: 4rem; margin-top: 3rem; }.paper-header-grid h1 { max-width: 22ch; margin-top: 1rem; font-size: clamp(2.6rem,6vw,6rem); font-weight: 500; letter-spacing: -.055em; line-height: .98; }.paper-authors { max-width: 55rem; margin-top: 1.8rem; color: var(--muted); font-size: .78rem; line-height: 1.75; }.paper-header-grid > aside { align-self: end; display: grid; gap: .6rem; border-left: 1px solid var(--line-bright); padding-left: 1.4rem; }.paper-header-grid aside span { margin-top: .8rem; color: var(--cyan); font: .52rem ui-monospace,monospace; letter-spacing: .1em; }.paper-header-grid aside strong,.paper-header-grid aside p { color: #c4d1e0; font-size: .72rem; font-weight: 500; line-height: 1.55; }.paper-links { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 2.5rem; }.paper-links a { border: 1px solid var(--line-bright); border-radius: .2rem; padding: .65rem .8rem; color: #d8e4f2; font: .58rem ui-monospace,monospace; text-transform: uppercase; }.paper-links a:hover { border-color: var(--cyan); color: var(--cyan); }
  .paper-layout { display: grid; grid-template-columns: minmax(0,1fr) 13rem; gap: clamp(3rem,8vw,8rem); padding-block: 5rem 8rem; }.paper-content { min-width: 0; }.paper-figure { margin-bottom: 5rem; border: 1px solid var(--line); background: #08111e; }.paper-figure img { max-height: 38rem; width: 100%; object-fit: contain; }.paper-figure figcaption { border-top: 1px solid var(--line); padding: .8rem 1rem; color: var(--muted); font-size: .66rem; line-height: 1.6; }.paper-figure a { color: var(--cyan); }.paper-content section { border-top: 1px solid var(--line); padding: 2.5rem 0 3.5rem; }.paper-content section > span { color: var(--cyan); font: .52rem ui-monospace,monospace; letter-spacing: .12em; }.paper-content h2 { margin-top: .8rem; font-size: clamp(1.8rem,3vw,3rem); font-weight: 500; letter-spacing: -.035em; }.paper-content section > p,.paper-content li { max-width: 55rem; margin-top: 1.2rem; color: #b1bfd1; font-size: .9rem; line-height: 1.85; }.paper-content ul { margin-top: 1.2rem; }.paper-content li { position: relative; margin-top: .65rem; padding-left: 1.3rem; }.paper-content li::before { position: absolute; left: 0; content: '→'; color: var(--mint); }.citation-box { margin-top: 1.2rem; border: 1px solid var(--line); background: #08111e; padding: 1.2rem; }.citation-box p { color: #b8c7d8; font: .72rem/1.7 ui-monospace,monospace; }.citation-box pre { margin-top: 1rem; overflow-x: auto; border-top: 1px solid var(--line); padding-top: 1rem; color: var(--muted); font: .65rem/1.6 ui-monospace,monospace; }.paper-index { position: sticky; top: 7rem; align-self: start; display: grid; gap: .8rem; border-left: 1px solid var(--line); padding-left: 1rem; color: #71869f; font: .55rem ui-monospace,monospace; text-transform: uppercase; }.paper-index p { margin-bottom: .4rem; color: var(--cyan); }.related-papers { border-top: 1px solid var(--line); padding-block: 5rem; background: #07101b; }.related-papers h2 { margin-top: .8rem; font-size: 2.5rem; font-weight: 500; }.related-papers .shell > div { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; margin-top: 2rem; }
  @media (max-width: 800px) { .paper-header-grid,.paper-layout { grid-template-columns: 1fr; }.paper-header-grid > aside,.paper-index { display: none; }.related-papers .shell > div { grid-template-columns: 1fr; } }
</style>
