---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import FigureLightbox from '../../components/research/FigureLightbox.astro';
import MetricStrip from '../../components/research/MetricStrip.astro';
import PaperTakeaway from '../../components/research/PaperTakeaway.astro';
import ResearchFigure from '../../components/research/ResearchFigure.astro';
import ResearchStorySection from '../../components/research/ResearchStorySection.astro';
import { externalPublicationLinks, getPublications, getPublicationSummary, isVerifiedPublicationText } from '../../utils/publications';
import { sitePath } from '../../utils/site';

export async function getStaticPaths() {
  const publications = await getPublications();
  return publications.map((publication) => ({ params: { slug: publication.slug }, props: { publication } }));
}

const { publication } = Astro.props;
const { data } = publication;
const story = data.story;
const links = externalPublicationLinks(publication);
const summary = getPublicationSummary(publication);
const verifiedResults = data.keyResults.filter((result: string) => isVerifiedPublicationText(result));
const citation = data.citation || `${data.authors.join(', ')}. (${data.year}). ${data.title}. ${data.venue}.`;
const related = (await getPublications()).filter((item) => item.slug !== publication.slug && item.data.tags.some((tag) => data.tags.includes(tag))).slice(0, 3);
const socialImage = story?.heroFigure.src || data.image;
const articleJsonLd = {
  '@context': 'https://schema.org', '@type': 'ScholarlyArticle',
  headline: data.title, abstract: isVerifiedPublicationText(data.abstract) ? data.abstract : summary,
  datePublished: String(data.year), author: data.authors.map((name: string) => ({ '@type': 'Person', name })),
  isPartOf: { '@type': 'Periodical', name: data.venue }, keywords: data.tags.join(', '),
  url: new URL(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`, Astro.site || Astro.url).toString(),
  image: socialImage ? new URL(socialImage, Astro.site || Astro.url).toString() : undefined,
};
---

<BaseLayout title={`${data.title} | Adarsh Bhandary Panambur`} description={story?.storyIntro || summary} image={socialImage} type="article" jsonLd={articleJsonLd}>
  <Nav />
  <main id="main-content">
    {story ? (
      <article class="visual-story">
        <header class="story-signal">
          <div class="story-grid grid-field" aria-hidden="true"></div>
          <div class="shell story-signal-inner">
            <a href={sitePath('publications/')} class="back-link">← PUBLICATION ARCHIVE</a>
            <div class="story-signal-top">
              <p>VISUAL RESEARCH BRIEF · {story.readTime.toUpperCase()}</p>
              <span>{data.type} / {data.year} / {data.status || 'Research output'}</span>
            </div>
            <p class="story-short-title">{story.shortTitle}</p>
            <h1>{story.researchQuestion}</h1>
            <div class="story-paper-meta">
              <p>{data.title}</p>
              <p>{data.authors.join(' · ')}</p>
              <p>{data.venue}</p>
            </div>
            <div class="story-tags">{data.tags.map((tag) => <span>{tag}</span>)}</div>
          </div>
        </header>

        <div class="shell story-stage">
          <ResearchFigure figure={story.heroFigure} hero />
          {story.signalStats.length > 0 && <MetricStrip metrics={story.signalStats} />}
        </div>

        <div class="shell story-layout">
          <div class="story-main">
            <section class="story-intro" aria-labelledby="story-intro-title">
              <p>00 / PAPER SIGNAL</p>
              <h2 id="story-intro-title">THE RESEARCH IN ONE PASS</h2>
              <strong>{story.storyIntro}</strong>
            </section>

            {story.sections.map((section) => <ResearchStorySection section={section} />)}

            {story.personalContribution && (
              <section id="contribution" class="personal-contribution">
                <p>07 / MY CONTRIBUTION</p><h2>WHAT I OWNED</h2><blockquote>{story.personalContribution}</blockquote>
              </section>
            )}

            <PaperTakeaway items={story.takeaway} />

            <section class="story-actions" aria-labelledby="story-actions-title">
              <p>FOLLOW THE EVIDENCE</p><h2 id="story-actions-title">READ / VERIFY / CITE</h2>
              <div>{links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}<button type="button" data-copy-citation data-citation={citation}>CITE ⧉</button></div>
              <span id="citation-status" aria-live="polite"></span>
            </section>

            <details class="paper-reference">
              <summary>ABSTRACT + CITATION</summary>
              <div><h2>Abstract</h2><p>{data.abstract}</p><h2>Citation</h2><p>{citation}</p>{isVerifiedPublicationText(data.bibtex) && <pre><code>{data.bibtex}</code></pre>}</div>
            </details>
          </div>

          <aside class="story-index" aria-label="Visual brief sections">
            <p>{story.readTime.toUpperCase()}</p>
            <a href="#main-content">Paper signal</a>
            {story.sections.map((section) => <a href={`#${section.id}`}>{section.label.replace(/^\d+\s*\/\s*/, '')}</a>)}
            {story.personalContribution && <a href="#contribution">My contribution</a>}
            <a href="#summary">30-second summary</a>
          </aside>
        </div>
        <FigureLightbox />
      </article>
    ) : (
      <article>
        <header class="paper-hero">
          <div class="paper-grid grid-field" aria-hidden="true"></div>
          <div class="shell paper-header-inner">
            <a href={sitePath('publications/')} class="back-link">← PUBLICATION ARCHIVE</a>
            <div class="paper-header-grid">
              <div><p class="section-kicker">{data.type} / {data.year} / {data.status || 'Research output'}</p><h1>{data.title}</h1><p class="paper-authors">{data.authors.join(' · ')}</p></div>
              <aside><span>VENUE</span><strong>{data.venue}</strong><span>TOPICS</span><p>{data.tags.join(' / ')}</p></aside>
            </div>
            {links.length > 0 && <div class="paper-links">{links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>}
          </div>
        </header>
        <div class="shell paper-layout">
          <div class="paper-content">
            {data.image && <figure class="paper-figure"><img src={data.image} alt={data.imageAlt || data.title} /><figcaption>{data.figureCaption}{data.sourceUrl && <> <a href={data.sourceUrl} target="_blank" rel="noopener noreferrer">{data.sourceLabel || 'Source'} ↗</a></>}</figcaption></figure>}
            <section><span>00 / OVERVIEW</span><h2>Scientific summary</h2><p>{summary}</p></section>
            {isVerifiedPublicationText(data.abstract) && <section><span>01 / ABSTRACT</span><h2>Abstract</h2><p>{data.abstract}</p></section>}
            <section><span>02 / RELEVANCE</span><h2>Why it matters</h2><p>{data.relevance}</p></section>
            {isVerifiedPublicationText(data.contribution) && <section><span>03 / CONTRIBUTION</span><h2>Contribution</h2><p>{data.contribution}</p></section>}
            {isVerifiedPublicationText(data.method) && <section><span>04 / METHOD</span><h2>Method overview</h2><p>{data.method}</p></section>}
            {verifiedResults.length > 0 && <section><span>05 / FINDINGS</span><h2>Key findings</h2><ul>{verifiedResults.map((result: string) => <li>{result}</li>)}</ul></section>}
            <section><span>06 / REFERENCE</span><h2>Citation</h2><div class="citation-box"><p>{citation}</p>{isVerifiedPublicationText(data.bibtex) && <pre><code>{data.bibtex}</code></pre>}</div></section>
          </div>
          <aside class="paper-index"><p>ON THIS PAGE</p><a href="#main-content">Overview</a>{isVerifiedPublicationText(data.abstract) && <span>Abstract</span>}<span>Why it matters</span>{isVerifiedPublicationText(data.method) && <span>Method</span>}<span>Citation</span></aside>
        </div>
      </article>
    )}

    {related.length > 0 && <section class="related-papers"><div class="shell"><p class="section-kicker">CONNECTED RESEARCH</p><h2>Related publications</h2><div>{related.map((item) => <PublicationCard publication={item} compact />)}</div></div></section>}
  </main>
  <Footer />
</BaseLayout>

<script>
  const citationButton = document.querySelector<HTMLButtonElement>('[data-copy-citation]');
  const citationStatus = document.getElementById('citation-status');
  citationButton?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(citationButton.dataset.citation || ''); if (citationStatus) citationStatus.textContent = 'Citation copied.'; }
    catch { if (citationStatus) citationStatus.textContent = 'Select the citation in the reference panel below.'; }
  });
</script>

<style>
  .back-link { color: #8397af; font: .58rem ui-monospace,monospace; letter-spacing: .1em; }.back-link:hover { color: var(--cyan); }
  .story-signal { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); padding: 8rem 0 4rem; background: radial-gradient(circle at 78% 30%,rgba(36,124,255,.34),transparent 31rem),radial-gradient(circle at 8% 78%,rgba(124,245,204,.09),transparent 24rem),var(--ink); }.story-grid { position: absolute; inset: 0; opacity: .46; }.story-signal-inner { position: relative; }.story-signal-top { display: flex; justify-content: space-between; gap: 1rem; margin-top: 3rem; color: var(--cyan); font: .56rem ui-monospace,monospace; letter-spacing: .12em; text-transform: uppercase; }.story-signal-top span { color: #8298b3; }.story-short-title { margin-top: 2.2rem; color: #c0cee0; font: 600 .72rem ui-monospace,monospace; letter-spacing: .12em; text-transform: uppercase; }.story-signal h1 { max-width: 18ch; margin-top: .8rem; font-size: clamp(3rem,7.5vw,8.5rem); font-weight: 500; letter-spacing: -.065em; line-height: .9; }.story-paper-meta { display: grid; grid-template-columns: 1.2fr 1fr .8fr; gap: 1rem; margin-top: 3.2rem; border-top: 1px solid var(--line); padding-top: 1.2rem; color: #9aadc4; font-size: .66rem; line-height: 1.55; }.story-tags { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.3rem; }.story-tags span { border: 1px solid var(--line); padding: .38rem .5rem; color: #a6b8cc; font: .5rem ui-monospace,monospace; text-transform: uppercase; }
  .story-stage { position: relative; z-index: 3; margin-top: 3rem; }.story-stage :global(.metric-strip) { margin-top: 1rem; }.story-layout { display: grid; grid-template-columns: minmax(0,1fr) 11rem; gap: clamp(3rem,7vw,7rem); }.story-main { min-width: 0; }.story-intro { padding-block: clamp(5rem,9vw,9rem); }.story-intro > p,.personal-contribution > p,.story-actions > p { color: var(--cyan); font: .55rem ui-monospace,monospace; letter-spacing: .12em; }.story-intro h2,.personal-contribution h2,.story-actions h2 { margin-top: .9rem; font-size: clamp(2rem,4vw,4rem); font-weight: 500; letter-spacing: -.045em; }.story-intro strong { display: block; max-width: 25ch; margin: 2.5rem 0 0 auto; color: #c8d6e6; font: 500 clamp(1.35rem,2.6vw,2.35rem)/1.35 Outfit,sans-serif; }
  .story-index { position: sticky; top: calc(7rem + var(--notice-height)); align-self: start; display: grid; gap: .8rem; margin-top: 5rem; border-left: 1px solid var(--line); padding-left: 1rem; color: #8094ad; font: .52rem ui-monospace,monospace; text-transform: uppercase; }.story-index p { margin-bottom: .35rem; color: var(--mint); }.story-index a:hover { color: var(--cyan); }
  .personal-contribution { scroll-margin-top: calc(6.5rem + var(--notice-height)); border-top: 1px solid var(--line); padding-block: clamp(5rem,8vw,8rem); }.personal-contribution blockquote { max-width: 50rem; margin: 2.5rem 0 0 auto; border-left: 2px solid var(--mint); padding-left: 1.5rem; color: #c4d2e1; font-size: 1.05rem; line-height: 1.8; }
  .story-actions { border-top: 1px solid var(--line); padding-block: 4rem; }.story-actions > div { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 2rem; }.story-actions a,.story-actions button { border: 1px solid var(--line-bright); padding: .7rem .85rem; color: #dce8f4; font: .57rem ui-monospace,monospace; text-transform: uppercase; }.story-actions a:hover,.story-actions button:hover { border-color: var(--cyan); color: var(--cyan); }.story-actions > span { display: block; min-height: 1.2rem; margin-top: .8rem; color: var(--mint); font-size: .62rem; }
  .paper-reference { margin-bottom: 7rem; border: 1px solid var(--line); background: var(--surface); }.paper-reference summary { cursor: pointer; padding: 1rem 1.2rem; color: var(--cyan); font: .58rem ui-monospace,monospace; letter-spacing: .1em; }.paper-reference > div { border-top: 1px solid var(--line); padding: 1.5rem; }.paper-reference h2 { margin-top: 1.5rem; font-size: 1.4rem; font-weight: 500; }.paper-reference h2:first-child { margin-top: 0; }.paper-reference p { max-width: 58rem; margin-top: .7rem; color: var(--muted); font-size: .76rem; line-height: 1.75; }.paper-reference pre { margin-top: 1rem; overflow-x: auto; border-top: 1px solid var(--line); padding-top: 1rem; color: #8799af; font: .63rem/1.65 ui-monospace,monospace; }
  .paper-hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); padding: 8rem 0 4.5rem; background: radial-gradient(circle at 75% 35%,rgba(36,124,255,.28),transparent 31rem),var(--ink); }.paper-grid { position: absolute; inset: 0; opacity: .44; }.paper-header-inner { position: relative; }.paper-header-grid { display: grid; grid-template-columns: minmax(0,1fr) 18rem; gap: 4rem; margin-top: 3rem; }.paper-header-grid h1 { max-width: 22ch; margin-top: 1rem; font-size: clamp(2.6rem,6vw,6rem); font-weight: 500; letter-spacing: -.055em; line-height: .98; }.paper-authors { max-width: 55rem; margin-top: 1.8rem; color: var(--muted); font-size: .78rem; line-height: 1.75; }.paper-header-grid > aside { align-self: end; display: grid; gap: .6rem; border-left: 1px solid var(--line-bright); padding-left: 1.4rem; }.paper-header-grid aside span { margin-top: .8rem; color: var(--cyan); font: .52rem ui-monospace,monospace; letter-spacing: .1em; }.paper-header-grid aside strong,.paper-header-grid aside p { color: #c4d1e0; font-size: .72rem; font-weight: 500; line-height: 1.55; }.paper-links { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 2.5rem; }.paper-links a { border: 1px solid var(--line-bright); border-radius: .2rem; padding: .65rem .8rem; color: #d8e4f2; font: .58rem ui-monospace,monospace; text-transform: uppercase; }.paper-links a:hover { border-color: var(--cyan); color: var(--cyan); }
  .paper-layout { display: grid; grid-template-columns: minmax(0,1fr) 13rem; gap: clamp(3rem,8vw,8rem); padding-block: 5rem 8rem; }.paper-content { min-width: 0; }.paper-figure { margin-bottom: 5rem; border: 1px solid var(--line); background: var(--surface); }.paper-figure img { max-height: 38rem; width: 100%; object-fit: contain; }.paper-figure figcaption { border-top: 1px solid var(--line); padding: .8rem 1rem; color: var(--muted); font-size: .66rem; line-height: 1.6; }.paper-figure a { color: var(--cyan); }.paper-content section { border-top: 1px solid var(--line); padding: 2.5rem 0 3.5rem; }.paper-content section > span { color: var(--cyan); font: .52rem ui-monospace,monospace; letter-spacing: .12em; }.paper-content h2 { margin-top: .8rem; font-size: clamp(1.8rem,3vw,3rem); font-weight: 500; letter-spacing: -.035em; }.paper-content section > p,.paper-content li { max-width: 55rem; margin-top: 1.2rem; color: #bdcadd; font-size: .9rem; line-height: 1.85; }.paper-content ul { margin-top: 1.2rem; }.paper-content li { position: relative; margin-top: .65rem; padding-left: 1.3rem; }.paper-content li::before { position: absolute; left: 0; content: '→'; color: var(--mint); }.citation-box { margin-top: 1.2rem; border: 1px solid var(--line); background: var(--surface); padding: 1.2rem; }.citation-box p { color: #c3d0df; font: .72rem/1.7 ui-monospace,monospace; }.citation-box pre { margin-top: 1rem; overflow-x: auto; border-top: 1px solid var(--line); padding-top: 1rem; color: var(--muted); font: .65rem/1.6 ui-monospace,monospace; }.paper-index { position: sticky; top: calc(7rem + var(--notice-height)); align-self: start; display: grid; gap: .8rem; border-left: 1px solid var(--line); padding-left: 1rem; color: #8094ad; font: .55rem ui-monospace,monospace; text-transform: uppercase; }.paper-index p { margin-bottom: .4rem; color: var(--cyan); }
  .related-papers { border-top: 1px solid var(--line); padding-block: 5rem; background: var(--surface); }.related-papers h2 { margin-top: .8rem; font-size: 2.5rem; font-weight: 500; }.related-papers .shell > div { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; margin-top: 2rem; }
  @media (max-width: 850px) { .story-paper-meta { grid-template-columns: 1fr; }.story-layout,.paper-header-grid,.paper-layout { grid-template-columns: 1fr; }.story-index,.paper-header-grid > aside,.paper-index { display: none; }.related-papers .shell > div { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .story-signal-top { display: grid; }.story-signal { padding-top: 7rem; }.story-stage { width: 100%; padding-inline: .7rem; } }
</style>
