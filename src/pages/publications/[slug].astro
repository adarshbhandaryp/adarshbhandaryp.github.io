---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import FigureLightbox from '../../components/research/FigureLightbox.astro';
import MetricStrip from '../../components/research/MetricStrip.astro';
import ResearchFigure from '../../components/research/ResearchFigure.astro';
import ResearchStorySection from '../../components/research/ResearchStorySection.astro';
import { externalPublicationLinks, getPublications } from '../../utils/publications';
import { sitePath } from '../../utils/site';

export async function getStaticPaths() {
  const publications = await getPublications();
  return publications.map((publication) => ({ params: { slug: publication.slug }, props: { publication } }));
}

const { publication } = Astro.props;
const { data } = publication;
const story = data.story;
const links = externalPublicationLinks(publication);
const citation = data.citation || `${data.authors.join(', ')}. (${data.year}). ${data.title}. ${data.venue}.`;
const related = (await getPublications())
  .filter((item) => item.slug !== publication.slug && item.data.tags.some((tag) => data.tags.includes(tag)))
  .slice(0, 3);
const socialImage = story?.heroFigure.src;
const doiUrl = data.links.doi
  ? (data.links.doi.startsWith('http') ? data.links.doi : `https://doi.org/${data.links.doi}`)
  : undefined;
const canonical = new URL(
  Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`,
  Astro.site || Astro.url,
).toString();

const articleJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: data.title,
  name: data.title,
  abstract: data.plainLanguageSummary,
  datePublished: String(data.year),
  inLanguage: 'en',
  author: data.authors.map((name: string) => ({ '@type': 'Person', name })),
  keywords: data.tags.join(', '),
  url: canonical,
  mainEntityOfPage: canonical,
  creativeWorkStatus: data.peerReviewed ? 'Published' : 'Draft',
};
if (data.type === 'journal') articleJsonLd.isPartOf = { '@type': 'Periodical', name: data.venue };
else articleJsonLd.publication = data.venue;
if (doiUrl) { articleJsonLd.sameAs = doiUrl; articleJsonLd.identifier = doiUrl; }
if (socialImage) articleJsonLd.image = new URL(socialImage, Astro.site || Astro.url).toString();
---

<BaseLayout
  title={`${data.title} | Adarsh Bhandary Panambur`}
  description={data.plainLanguageSummary}
  image={socialImage}
  type="article"
  jsonLd={articleJsonLd}
>
  <Nav />
  <main id="main-content">
    {story ? (
      <article class="visual-story">
        <header class="story-head">
          <div class="story-bg grid-field" aria-hidden="true"></div>
          <div class="shell story-head-inner">
            <a href={sitePath('publications/')} class="back-link">← All publications</a>
            <div class="story-head-top">
              <p>{story.readTime.toUpperCase()}</p>
              <span>{data.type} · {data.year}{data.status ? ` · ${data.status}` : ''}</span>
            </div>
            <p class="story-short-title">{story.shortTitle}</p>
            <h1>{story.researchQuestion}</h1>
            {!data.peerReviewed && <p class="story-flag">Not peer reviewed — treat the numbers below as preliminary.</p>}
            <dl class="story-paper-meta">
              <div><dt>Paper</dt><dd>{data.title}</dd></div>
              <div><dt>Authors</dt><dd>{data.authors.join(' · ')}</dd></div>
              <div><dt>Venue</dt><dd>{data.venue}</dd></div>
            </dl>
            <div class="story-tags">{data.tags.map((tag) => <span>{tag}</span>)}</div>
          </div>
        </header>

        <div class="shell story-stage">
          <ResearchFigure figure={story.heroFigure} hero />
          {story.signalStats.length > 0 && <MetricStrip metrics={story.signalStats} />}
        </div>

        <div class="shell story-layout">
          <div class="story-main">
            <section class="story-intro" aria-labelledby="story-intro-title">
              <p>IN ONE SENTENCE</p>
              <h2 id="story-intro-title" class="sr-only">Summary</h2>
              <strong>{story.storyIntro}</strong>
            </section>

            {story.sections.map((section) => <ResearchStorySection section={section} />)}

            {story.limitation && (
              <section id="limitation" class="story-limitation" aria-labelledby="limitation-title">
                <p>LIMITATION</p>
                <h2 id="limitation-title">What this does not show</h2>
                <blockquote>{story.limitation}</blockquote>
              </section>
            )}

            {story.personalContribution && (
              <section id="contribution" class="story-contribution" aria-labelledby="contribution-title">
                <p>MY ROLE</p>
                <h2 id="contribution-title">What I did</h2>
                <blockquote>{story.personalContribution}</blockquote>
              </section>
            )}

            <section class="story-actions" aria-labelledby="story-actions-title">
              <p>READ IT YOURSELF</p>
              <h2 id="story-actions-title">Paper · DOI · Code · Citation</h2>
              <div>
                {links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}
                <button type="button" data-copy-citation data-citation={citation}>Copy citation ⧉</button>
              </div>
              <span id="citation-status" aria-live="polite"></span>
            </section>

            <details class="paper-reference">
              <summary>View original abstract + citation</summary>
              <div>
                <h3>Abstract</h3>
                <p>{data.abstract}</p>
                <h3>Citation</h3>
                <p class="citation-line">{citation}</p>
                {data.bibtex && <pre><code>{data.bibtex}</code></pre>}
              </div>
            </details>
          </div>

          <aside class="story-index" aria-label="On this page">
            <p>{story.readTime.toUpperCase()}</p>
            <a href="#main-content">Overview</a>
            {story.sections.map((section) => <a href={`#${section.id}`}>{section.label.replace(/^\d+\s*\/\s*/, '')}</a>)}
            {story.limitation && <a href="#limitation">Limitation</a>}
            {story.personalContribution && <a href="#contribution">My role</a>}
          </aside>
        </div>
        <FigureLightbox />
      </article>
    ) : (
      <article>
        <header class="paper-hero">
          <div class="story-bg grid-field" aria-hidden="true"></div>
          <div class="shell paper-header-inner">
            <a href={sitePath('publications/')} class="back-link">← All publications</a>
            <div class="paper-header-grid">
              <div>
                <p class="section-kicker">{data.type} · {data.year}{data.status ? ` · ${data.status}` : ''}</p>
                <h1>{data.title}</h1>
                <p class="paper-authors">{data.authors.join(' · ')}</p>
                {!data.peerReviewed && <p class="story-flag">Not peer reviewed.</p>}
              </div>
              <aside>
                <span>Venue</span><strong>{data.venue}</strong>
                <span>Topics</span><p>{data.tags.join(' · ')}</p>
              </aside>
            </div>
            {links.length > 0 && (
              <div class="paper-links">{links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>
            )}
          </div>
        </header>

        <div class="shell paper-layout">
          <div class="paper-content">
            <section id="summary"><span>01 / SUMMARY</span><h2>What this paper does</h2><p>{data.plainLanguageSummary}</p></section>
            <section id="method"><span>02 / METHOD</span><h2>How</h2><p>{data.method}</p></section>
            {data.keyResults.length > 0 && (
              <section id="findings"><span>03 / FINDINGS</span><h2>Reported results</h2><ul>{data.keyResults.map((result: string) => <li>{result}</li>)}</ul></section>
            )}
            <section id="relevance"><span>04 / WHY IT MATTERS</span><h2>Relevance</h2><p>{data.relevance}</p></section>
            {data.limitation && (
              <section id="limitation"><span>05 / LIMITATION</span><h2>What it does not show</h2><p>{data.limitation}</p></section>
            )}
            <section id="cite"><span>06 / REFERENCE</span><h2>Citation</h2>
              <div class="citation-box"><p>{citation}</p>{data.bibtex && <pre><code>{data.bibtex}</code></pre>}</div>
              <details class="paper-reference inline"><summary>View original abstract</summary><div><p>{data.abstract}</p></div></details>
            </section>
          </div>

          <aside class="paper-index" aria-label="On this page">
            <p>On this page</p>
            <a href="#summary">Summary</a>
            <a href="#method">Method</a>
            {data.keyResults.length > 0 && <a href="#findings">Findings</a>}
            <a href="#relevance">Why it matters</a>
            {data.limitation && <a href="#limitation">Limitation</a>}
            <a href="#cite">Citation</a>
          </aside>
        </div>
      </article>
    )}

    {related.length > 0 && (
      <section class="related-papers">
        <div class="shell">
          <p class="section-kicker">Related work</p>
          <h2>Connected publications</h2>
          <div>{related.map((item) => <PublicationCard publication={item} />)}</div>
        </div>
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>

<script>
  const citationButton = document.querySelector<HTMLButtonElement>('[data-copy-citation]');
  const citationStatus = document.getElementById('citation-status');
  citationButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(citationButton.dataset.citation || '');
      if (citationStatus) citationStatus.textContent = 'Citation copied.';
    } catch {
      if (citationStatus) citationStatus.textContent = 'Copy blocked — the citation is in the reference panel below.';
    }
  });
</script>

<style>
  .back-link { color: #8397af; font: .6rem ui-monospace,monospace; letter-spacing: .06em; }
  .back-link:hover { color: var(--cyan); }
  .story-bg { position: absolute; inset: 0; opacity: .38; }
  .story-flag { display: inline-block; margin-top: 1.4rem; border: 1px solid rgba(246,200,110,.35); padding: .45rem .6rem; color: var(--amber); font: .6rem ui-monospace,monospace; letter-spacing: .04em; }

  .story-head { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); padding: 8rem 0 3rem; background: radial-gradient(circle at 78% 30%,rgba(36,124,255,.26),transparent 31rem),var(--ink); }
  .story-head-inner { position: relative; }
  .story-head-top { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2.2rem; color: var(--cyan); font: 600 .56rem ui-monospace,monospace; letter-spacing: .12em; text-transform: uppercase; }
  .story-head-top span { color: #8298b3; font-weight: 400; }
  .story-short-title { margin-top: 1.8rem; color: #c0cee0; font: 600 .68rem ui-monospace,monospace; letter-spacing: .12em; text-transform: uppercase; }
  .story-head h1 { max-width: 22ch; margin-top: .8rem; font-size: clamp(2.4rem,5.6vw,5.5rem); font-weight: 500; letter-spacing: -.055em; line-height: .95; }
  .story-paper-meta { display: grid; grid-template-columns: 1.3fr 1.4fr .9fr; gap: 1.5rem; margin-top: 2.6rem; border-top: 1px solid var(--line); padding-top: 1.2rem; }
  .story-paper-meta dt { color: var(--cyan); font: 600 .5rem ui-monospace,monospace; letter-spacing: .12em; text-transform: uppercase; }
  .story-paper-meta dd { margin: .5rem 0 0; color: #9aadc4; font-size: .7rem; line-height: 1.6; }
  .story-tags { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.3rem; }
  .story-tags span { border: 1px solid var(--line); padding: .34rem .48rem; color: #a6b8cc; font: .5rem ui-monospace,monospace; text-transform: uppercase; }

  .story-stage { position: relative; z-index: 3; margin-top: 2.5rem; }
  .story-stage :global(.metric-strip) { margin-top: 1rem; }
  .story-layout { display: grid; grid-template-columns: minmax(0,1fr) 10rem; gap: clamp(2.5rem,6vw,6rem); padding-bottom: 5rem; }
  .story-main { min-width: 0; }
  .story-intro { padding-block: clamp(2.8rem,5vw,4.5rem); }
  .story-intro > p, .story-limitation > p, .story-contribution > p, .story-actions > p { color: var(--cyan); font: 600 .55rem ui-monospace,monospace; letter-spacing: .12em; }
  .story-intro strong { display: block; max-width: 36ch; margin-top: 1.4rem; color: #d3e0ef; font: 500 clamp(1.2rem,2.2vw,1.85rem)/1.42 Outfit,sans-serif; }

  .story-index { position: sticky; top: calc(6.5rem + var(--notice-height)); align-self: start; display: grid; gap: .75rem; margin-top: 3.5rem; border-left: 1px solid var(--line); padding-left: .9rem; color: #8094ad; font: .52rem ui-monospace,monospace; letter-spacing: .04em; text-transform: uppercase; }
  .story-index p { margin-bottom: .3rem; color: var(--mint); }
  .story-index a:hover { color: var(--cyan); }

  .story-limitation, .story-contribution { scroll-margin-top: calc(6rem + var(--notice-height)); border-top: 1px solid var(--line); padding-block: clamp(2.6rem,5vw,4rem); }
  .story-limitation h2, .story-contribution h2 { margin-top: .8rem; font-size: clamp(1.4rem,2.6vw,2.1rem); font-weight: 500; letter-spacing: -.03em; }
  .story-limitation blockquote, .story-contribution blockquote { max-width: 46rem; margin: 1.4rem 0 0; border-left: 2px solid var(--amber); padding-left: 1.2rem; color: #c4d2e1; font-size: .95rem; line-height: 1.8; }
  .story-contribution blockquote { border-left-color: var(--mint); }

  .story-actions { border-top: 1px solid var(--line); padding-block: clamp(2.6rem,5vw,4rem); }
  .story-actions h2 { margin-top: .8rem; font-size: clamp(1.4rem,2.6vw,2.1rem); font-weight: 500; letter-spacing: -.03em; }
  .story-actions > div { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.5rem; }
  .story-actions a, .story-actions button { border: 1px solid var(--line-bright); padding: .65rem .8rem; color: #dce8f4; font: .58rem ui-monospace,monospace; letter-spacing: .04em; }
  .story-actions a:hover, .story-actions button:hover { border-color: var(--cyan); color: var(--cyan); }
  .story-actions > span { display: block; min-height: 1.2rem; margin-top: .8rem; color: var(--mint); font-size: .62rem; }

  .paper-reference { margin-bottom: 3rem; border: 1px solid var(--line); background: var(--surface); }
  .paper-reference summary { cursor: pointer; padding: .9rem 1.1rem; color: var(--cyan); font: .6rem ui-monospace,monospace; letter-spacing: .06em; }
  .paper-reference > div { border-top: 1px solid var(--line); padding: 1.3rem; }
  .paper-reference h3 { margin-top: 1.3rem; font-size: .95rem; font-weight: 600; }
  .paper-reference h3:first-child { margin-top: 0; }
  .paper-reference p { max-width: 56rem; margin-top: .6rem; color: var(--muted); font-size: .78rem; line-height: 1.78; }
  .paper-reference .citation-line { font-family: ui-monospace,monospace; font-size: .7rem; }
  .paper-reference pre { margin-top: 1rem; overflow-x: auto; border-top: 1px solid var(--line); padding-top: 1rem; color: #8799af; font: .63rem/1.65 ui-monospace,monospace; }
  .paper-reference.inline { margin-top: 1.5rem; margin-bottom: 0; }

  .paper-hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); padding: 8rem 0 4rem; background: radial-gradient(circle at 75% 35%,rgba(36,124,255,.22),transparent 31rem),var(--ink); }
  .paper-header-inner { position: relative; }
  .paper-header-grid { display: grid; grid-template-columns: minmax(0,1fr) 17rem; gap: 3.5rem; margin-top: 2.4rem; }
  .paper-header-grid h1 { max-width: 24ch; margin-top: 1rem; font-size: clamp(2.1rem,4.6vw,4rem); font-weight: 500; letter-spacing: -.045em; line-height: 1.04; }
  .paper-authors { max-width: 52rem; margin-top: 1.5rem; color: var(--muted); font-size: .78rem; line-height: 1.75; }
  .paper-header-grid > aside { align-self: end; display: grid; gap: .5rem; border-left: 1px solid var(--line-bright); padding-left: 1.3rem; }
  .paper-header-grid aside span { margin-top: .7rem; color: var(--cyan); font: 600 .5rem ui-monospace,monospace; letter-spacing: .1em; text-transform: uppercase; }
  .paper-header-grid aside strong, .paper-header-grid aside p { color: #c4d1e0; font-size: .74rem; font-weight: 500; line-height: 1.55; }
  .paper-links { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 2.2rem; }
  .paper-links a { border: 1px solid var(--line-bright); border-radius: .2rem; padding: .6rem .75rem; color: #d8e4f2; font: .58rem ui-monospace,monospace; letter-spacing: .04em; }
  .paper-links a:hover { border-color: var(--cyan); color: var(--cyan); }

  .paper-layout { display: grid; grid-template-columns: minmax(0,1fr) 11rem; gap: clamp(2.5rem,6vw,6rem); padding-block: 3.5rem 6rem; }
  .paper-content { min-width: 0; }
  .paper-content section { border-top: 1px solid var(--line); padding: 1.8rem 0 2.2rem; scroll-margin-top: calc(6rem + var(--notice-height)); }
  .paper-content section:first-child { border-top: 0; }
  .paper-content section > span { color: var(--cyan); font: 600 .52rem ui-monospace,monospace; letter-spacing: .12em; }
  .paper-content h2 { margin-top: .7rem; font-size: clamp(1.4rem,2.4vw,2.1rem); font-weight: 500; letter-spacing: -.03em; }
  .paper-content section > p, .paper-content li { max-width: 52rem; margin-top: 1rem; color: #bdcadd; font-size: .9rem; line-height: 1.85; }
  .paper-content ul { margin-top: 1rem; }
  .paper-content li { position: relative; margin-top: .6rem; padding-left: 1.2rem; }
  .paper-content li::before { position: absolute; left: 0; content: '→'; color: var(--mint); }
  .citation-box { margin-top: 1rem; border: 1px solid var(--line); background: var(--surface); padding: 1.1rem; }
  .citation-box p { color: #c3d0df; font: .72rem/1.7 ui-monospace,monospace; }
  .citation-box pre { margin-top: 1rem; overflow-x: auto; border-top: 1px solid var(--line); padding-top: 1rem; color: var(--muted); font: .65rem/1.6 ui-monospace,monospace; }
  .paper-index { position: sticky; top: calc(6.5rem + var(--notice-height)); align-self: start; display: grid; gap: .75rem; border-left: 1px solid var(--line); padding-left: .9rem; color: #8094ad; font: .55rem ui-monospace,monospace; text-transform: uppercase; }
  .paper-index p { margin-bottom: .35rem; color: var(--cyan); }
  .paper-index a:hover { color: var(--cyan); }

  .related-papers { border-top: 1px solid var(--line); padding-block: 4rem; background: var(--surface); }
  .related-papers h2 { margin-top: .7rem; font-size: 1.9rem; font-weight: 500; }
  .related-papers .shell > div { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; margin-top: 2rem; }

  @media (max-width: 900px) {
    .story-paper-meta { grid-template-columns: 1fr; gap: 1rem; }
    .story-layout, .paper-header-grid, .paper-layout { grid-template-columns: 1fr; }
    .story-index, .paper-header-grid > aside, .paper-index { display: none; }
    .related-papers .shell > div { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .story-head-top { display: grid; }
    .story-head { padding-top: 7rem; }
  }
</style>
