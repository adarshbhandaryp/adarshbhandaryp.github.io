---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import AISystemsFlagship from '../components/AISystemsFlagship.astro';
import DataPipeline from '../components/DataPipeline.astro';
import FeaturedResearch from '../components/FeaturedResearch.astro';
import ScaleSection from '../components/ScaleSection.astro';
import ResearchConstellation from '../components/ResearchConstellation.astro';
import ExperienceJourney from '../components/ExperienceJourney.astro';
import FlagshipPublications from '../components/FlagshipPublications.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Adarsh Bhandary Panambur | Research Scientist · AI Systems · Medical AI · HPC"
  description="Research Scientist at NHR@FAU building locally deployed LLM and VLM applications, retrieval and agent workflows, scalable GPU inference, multimodal AI, and clinically grounded medical AI systems."
>
  <Nav />
  <main id="main-content">
    <Hero />
    <AISystemsFlagship />
    <div data-research-depth><DataPipeline /></div>
    <FeaturedResearch />
    <div data-research-depth><ScaleSection /></div>
    <div data-research-depth><ResearchConstellation /></div>
    <ExperienceJourney />
    <FlagshipPublications />
    <Contact />
  </main>
  <Footer />

  <script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealElements = document.querySelectorAll<HTMLElement>('.reveal');
    if (reducedMotion || !('IntersectionObserver' in window)) revealElements.forEach((element) => element.classList.add('is-visible'));
    else {
      const revealObserver = new IntersectionObserver((entries, observer) => entries.forEach((entry) => {
        if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
      }), { rootMargin: '0px 0px -8%', threshold: .08 });
      revealElements.forEach((element) => revealObserver.observe(element));
    }
  </script>
</BaseLayout>
