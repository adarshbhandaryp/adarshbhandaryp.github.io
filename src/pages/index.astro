---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import AISystemsFlagship from '../components/AISystemsFlagship.astro';
import DataPipeline from '../components/DataPipeline.astro';
import FeaturedResearch from '../components/FeaturedResearch.astro';
import TechnicalEvolution from '../components/TechnicalEvolution.astro';
import Skills from '../components/Skills.astro';
import ExperienceJourney from '../components/ExperienceJourney.astro';
import FlagshipPublications from '../components/FlagshipPublications.astro';
import Gallery from '../components/Gallery.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Adarsh Bhandary Panambur — Research Scientist, Medical &amp; Multimodal AI"
  description="Research Scientist at NHR@FAU, PhD researcher at FAU Erlangen-Nürnberg. Self-supervised learning, vision-language models, medical AI, GPU/HPC inference."
>
  <Nav />
  <main id="main-content">
    <Hero />
    <AISystemsFlagship />
    <DataPipeline />
    <FeaturedResearch />
    <TechnicalEvolution />
    <Skills />
    <ExperienceJourney />
    <FlagshipPublications />
    <Gallery kicker="08 / TALKS" id="talks" showLink />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
