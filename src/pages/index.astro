---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import DataPipeline from '../components/DataPipeline.astro';
import FeaturedResearch from '../components/FeaturedResearch.astro';
import ScaleSection from '../components/ScaleSection.astro';
import ResearchConstellation from '../components/ResearchConstellation.astro';
import ExperienceJourney from '../components/ExperienceJourney.astro';
import Gallery from '../components/Gallery.astro';
import CurrentWork from '../components/CurrentWork.astro';
import CapabilityMatrix from '../components/CapabilityMatrix.astro';
import FlagshipPublications from '../components/FlagshipPublications.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Adarsh Bhandary Panambur | Medical AI, Multimodal AI & HPC"
  description="Research Scientist at NHR@FAU building medical AI, vision-language models, multimodal systems, GPU infrastructure, and clinically grounded research software."
>
  <Nav />
  <main id="main-content">
    <Hero />
    <DataPipeline />
    <FeaturedResearch />
    <ScaleSection />
    <ResearchConstellation />
    <ExperienceJourney />
    <Gallery />
    <CurrentWork />
    <CapabilityMatrix />
    <FlagshipPublications />
    <Contact />
  </main>
  <Footer />

  <script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealElements = document.querySelectorAll<HTMLElement>('.reveal');
    if (reducedMotion || !('IntersectionObserver' in window)) revealElements.forEach((element) => element.classList.add('is-visible'));
    else {
      const revealObserver = new IntersectionObserver((entries, observer) => entries.forEach((entry) => {
        if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
      }), { rootMargin: '0px 0px -8%', threshold: .08 });
      revealElements.forEach((element) => revealObserver.observe(element));
    }
  </script>
</BaseLayout>
