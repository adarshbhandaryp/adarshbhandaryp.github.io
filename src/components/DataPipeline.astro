---
const stages = [
  { index: '01', label: 'DATA', detail: 'High-resolution mammography, breast MRI, CT and cell imaging — curated and standardized.' },
  { index: '02', label: 'REPRESENTATION LEARNING', detail: 'Self-supervised pretraining on the target cohort rather than on ImageNet alone.' },
  { index: '03', label: 'VISION / LANGUAGE', detail: 'Aligning image regions with radiology language so models can be described, not just scored.' },
  { index: '04', label: 'REASONING', detail: 'Structured findings, BI-RADS categories, generated reports and grounded evidence.' },
  { index: '05', label: 'AI SYSTEMS', detail: 'Distributed training, GPU inference and serving that make the above reproducible.' },
  { index: '06', label: 'CLINICAL APPLICATION', detail: 'Retrospective evaluation with radiologists on real, external cohorts.' },
];
---

<section id="representation" class="section-shell pipeline-section section-rule" aria-labelledby="pipeline-title">
  <div class="shell">
    <div class="pipeline-heading reveal">
      <div>
        <p class="section-kicker">02 / THE THREAD</p>
        <h2 id="pipeline-title" class="section-title">FROM DATA TO INTELLIGENCE</h2>
      </div>
      <p class="section-copy">One line runs through everything I have worked on: keep the information that matters in a difficult image, learn a representation from it, connect that representation to language and reasoning, then make it run and hold up on someone else's data.</p>
    </div>

    <div class="pipeline-frame reveal" data-pipeline>
      <div class="pipeline-beam" aria-hidden="true"></div>
      <ol class="pipeline-canvas">
        {stages.map((stage, index) => (
          <li class="pipeline-stage" data-pipeline-stage data-index={index}>
            <span class="stage-index">{stage.index}</span>
            <h3>{stage.label}</h3>
            <p>{stage.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  const pipeline = document.querySelector<HTMLElement>('[data-pipeline]');
  const stages = Array.from(document.querySelectorAll<HTMLElement>('[data-pipeline-stage]'));
  if (pipeline && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const stage = entry.target as HTMLElement;
          const index = Number(stage.dataset.index || 0);
          stages.forEach((item, itemIndex) => item.classList.toggle('is-active', itemIndex <= index));
          pipeline.style.setProperty('--pipeline-progress', `${(index / (stages.length - 1)) * 100}%`);
        }
      });
    }, { rootMargin: '-35% 0px -50%', threshold: .1 });
    stages.forEach((stage) => observer.observe(stage));
  } else {
    stages.forEach((stage) => stage.classList.add('is-active'));
  }
</script>

<style>
  .pipeline-section { overflow: hidden; background: linear-gradient(180deg,var(--ink),var(--surface) 55%,var(--ink)); }
  .pipeline-heading { display: grid; grid-template-columns: 1.1fr .9fr; align-items: end; gap: 3rem; }
  .pipeline-frame { --pipeline-progress: 0%; position: relative; margin-top: clamp(3.5rem,8vw,7rem); }
  .pipeline-canvas { position: relative; display: grid; grid-template-columns: repeat(6,1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .pipeline-canvas::after { position: absolute; z-index: 0; left: 0; top: -.5px; width: var(--pipeline-progress); height: 1px; content: ''; background: var(--cyan); transition: width .8s cubic-bezier(.2,.8,.2,1); }
  .pipeline-beam { position: absolute; z-index: 0; left: var(--pipeline-progress); top: -2rem; width: 1px; height: calc(100% + 4rem); opacity: .3; background: linear-gradient(transparent,var(--cyan),transparent); transition: left .8s cubic-bezier(.2,.8,.2,1); }
  .pipeline-stage { position: relative; z-index: 1; min-width: 0; min-height: 15rem; border-right: 1px solid var(--line); padding: 1rem clamp(.7rem,1.4vw,1.2rem) 1.6rem; opacity: .72; transition: opacity .5s ease, background .5s ease; }
  .pipeline-stage:last-child { border-right: 0; }
  .pipeline-stage.is-active { opacity: 1; background: linear-gradient(180deg,rgba(50,199,255,.045),transparent); }
  .stage-index { color: #8ba0b8; font-family: ui-monospace,monospace; font-size: .55rem; }
  .pipeline-stage h3 { margin-top: 2.6rem; color: var(--mint); font-family: ui-monospace,monospace; font-size: clamp(.56rem,.76vw,.68rem); font-weight: 600; letter-spacing: .08em; line-height: 1.55; }
  .pipeline-stage p { margin-top: .8rem; color: var(--muted); font-size: clamp(.67rem,.85vw,.76rem); line-height: 1.6; }
  @media (max-width: 950px) {
    .pipeline-heading { grid-template-columns: 1fr; }
    .pipeline-canvas { grid-template-columns: repeat(2,1fr); }
    .pipeline-stage { min-height: 12rem; }
    .pipeline-stage:nth-child(2n) { border-right: 0; }
    .pipeline-beam { display: none; }
    .pipeline-canvas::after { display: none; }
    .pipeline-stage { opacity: 1; }
  }
  @media (max-width: 560px) {
    .pipeline-canvas { grid-template-columns: 1fr; }
    .pipeline-stage { min-height: 0; border-right: 0; border-bottom: 1px solid var(--line); padding-block: 1.1rem 1.3rem; }
    .pipeline-stage:last-child { border-bottom: 0; }
    .pipeline-stage h3 { margin-top: .7rem; }
  }
</style>
