---
const stages = [
  { index: '01', label: 'DATA', glyph: 'patches', detail: 'High-resolution mammography, breast MRI, CT and cell imaging — curated and standardized.' },
  { index: '02', label: 'REPRESENTATION LEARNING', glyph: 'embedding', detail: 'Self-supervised pretraining on the target cohort rather than on ImageNet alone.' },
  { index: '03', label: 'VISION / LANGUAGE', glyph: 'align', detail: 'Aligning image regions with radiology language so models can be described, not just scored.' },
  { index: '04', label: 'REASONING', glyph: 'branch', detail: 'Structured findings, BI-RADS categories, generated reports and grounded evidence.' },
  { index: '05', label: 'AI SYSTEMS', glyph: 'lanes', detail: 'Distributed training, GPU inference and serving that make the above reproducible.' },
  { index: '06', label: 'CLINICAL APPLICATION', glyph: 'validate', detail: 'Retrospective evaluation with radiologists on real, external cohorts.' },
];
---

<section id="representation" class="section-shell pipeline-section section-rule" aria-labelledby="pipeline-title">
  <div class="shell">
    <div class="pipeline-heading reveal">
      <div>
        <p class="section-kicker">02 / THE THREAD</p>
        <h2 id="pipeline-title" class="section-title">FROM DATA TO INTELLIGENCE</h2>
      </div>
      <p class="section-copy">One line runs through everything I have worked on: keep the information that matters in a difficult image, learn a representation from it, connect that representation to language and reasoning, then make it run and hold up on someone else's data.</p>
    </div>

    <div class="pipeline-frame reveal" data-pipeline>
      <div class="pipeline-beam" aria-hidden="true"></div>
      <ol class="pipeline-canvas">
        {stages.map((stage, index) => (
          <li class="pipeline-stage" data-pipeline-stage data-index={index}>
            <span class="stage-index">{stage.index}</span>
            <div class={`stage-glyph glyph-${stage.glyph}`} aria-hidden="true">
              {stage.glyph === 'patches' && (
                <svg viewBox="0 0 48 34">
                  {Array.from({ length: 18 }).map((_, cell) => (
                    <rect class="patch" style={`--i:${cell}`} x={(cell % 6) * 8} y={Math.floor(cell / 6) * 11.5} width="6.4" height="9.2" rx="1" />
                  ))}
                </svg>
              )}
              {stage.glyph === 'embedding' && (
                <svg viewBox="0 0 48 34">
                  {[14, 26, 8, 31, 19, 24, 11, 29].map((height, bar) => (
                    <rect class="bar" style={`--i:${bar};--h:${height}`} x={bar * 6} y={34 - height} width="4.1" height={height} rx=".8" />
                  ))}
                </svg>
              )}
              {stage.glyph === 'align' && (
                <svg viewBox="0 0 48 34">
                  <rect class="region" x="1" y="3" width="15" height="12" rx="1.5" />
                  <rect class="region region-2" x="1" y="19" width="15" height="12" rx="1.5" />
                  <line class="link" x1="16" y1="9" x2="31" y2="7" />
                  <line class="link link-2" x1="16" y1="25" x2="31" y2="15" />
                  <line class="link link-3" x1="16" y1="9" x2="31" y2="23" />
                  <rect class="token" x="31" y="5" width="16" height="4" rx="2" />
                  <rect class="token token-2" x="31" y="13" width="12" height="4" rx="2" />
                  <rect class="token token-3" x="31" y="21" width="14" height="4" rx="2" />
                </svg>
              )}
              {stage.glyph === 'branch' && (
                <svg viewBox="0 0 48 34">
                  <path class="edge" d="M4 17 H16" />
                  <path class="edge edge-2" d="M16 17 C24 17 24 7 32 7" />
                  <path class="edge edge-3" d="M16 17 C24 17 24 27 32 27" />
                  <path class="edge edge-4" d="M32 7 H44" />
                  <path class="edge edge-5" d="M32 27 H44" />
                  <circle class="node" cx="4" cy="17" r="2.6" />
                  <circle class="node node-2" cx="16" cy="17" r="2.2" />
                  <circle class="node node-3" cx="32" cy="7" r="2.2" />
                  <circle class="node node-4" cx="32" cy="27" r="2.2" />
                  <circle class="node node-5" cx="45" cy="7" r="2.6" />
                  <circle class="node node-6" cx="45" cy="27" r="2.6" />
                </svg>
              )}
              {stage.glyph === 'lanes' && (
                <svg viewBox="0 0 48 34">
                  {[5, 13, 21, 29].map((y, lane) => (
                    <g>
                      <line class="lane" x1="1" y1={y} x2="47" y2={y} />
                      <circle class="packet" style={`--i:${lane}`} cy={y} r="1.9" />
                    </g>
                  ))}
                </svg>
              )}
              {stage.glyph === 'validate' && (
                <svg viewBox="0 0 48 34">
                  <circle class="ring-track" cx="15" cy="17" r="13" />
                  <circle class="ring" cx="15" cy="17" r="13" />
                  <path class="tick" d="M8.5 17 L13.5 22.5 L23 10.5" />
                  <line class="cohort" x1="33" y1="11" x2="47" y2="11" />
                  <line class="cohort cohort-2" x1="33" y1="17" x2="43" y2="17" />
                  <line class="cohort cohort-3" x1="33" y1="23" x2="45" y2="23" />
                </svg>
              )}
            </div>
            <h3>{stage.label}</h3>
            <p>{stage.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  const pipeline = document.querySelector<HTMLElement>('[data-pipeline]');
  const stages = Array.from(document.querySelectorAll<HTMLElement>('[data-pipeline-stage]'));
  if (pipeline && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const stage = entry.target as HTMLElement;
          const index = Number(stage.dataset.index || 0);
          stages.forEach((item, itemIndex) => item.classList.toggle('is-active', itemIndex <= index));
          pipeline.style.setProperty('--pipeline-progress', `${(index / (stages.length - 1)) * 100}%`);
        }
      });
    }, { rootMargin: '-35% 0px -50%', threshold: .1 });
    stages.forEach((stage) => observer.observe(stage));
  } else {
    stages.forEach((stage) => stage.classList.add('is-active'));
  }
</script>

<style>
  .pipeline-section { overflow: hidden; background: linear-gradient(180deg,var(--ink),var(--surface) 55%,var(--ink)); }
  .pipeline-heading { display: grid; grid-template-columns: 1.1fr .9fr; align-items: end; gap: 3rem; }
  .pipeline-frame { --pipeline-progress: 0%; position: relative; margin-top: clamp(3rem,6vw,5.5rem); }
  .pipeline-canvas { position: relative; display: grid; grid-template-columns: repeat(6,1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .pipeline-canvas::after { position: absolute; z-index: 0; left: 0; top: -.5px; width: var(--pipeline-progress); height: 1px; content: ''; background: var(--cyan); transition: width .8s cubic-bezier(.2,.8,.2,1); }
  .pipeline-beam { position: absolute; z-index: 0; left: var(--pipeline-progress); top: -2rem; width: 1px; height: calc(100% + 4rem); opacity: .3; background: linear-gradient(transparent,var(--cyan),transparent); transition: left .8s cubic-bezier(.2,.8,.2,1); }
  .pipeline-stage { position: relative; z-index: 1; min-width: 0; min-height: 15rem; border-right: 1px solid var(--line); padding: 1rem clamp(.7rem,1.4vw,1.2rem) 1.6rem; opacity: .72; transition: opacity .5s ease, background .5s ease; }
  .pipeline-stage:last-child { border-right: 0; }
  .pipeline-stage.is-active { opacity: 1; background: linear-gradient(180deg,rgba(50,199,255,.045),transparent); }
  .stage-index { color: #8ba0b8; font-family: ui-monospace,monospace; font-size: .75rem; }
  .pipeline-stage h3 { margin-top: 1.1rem; color: var(--mint); font-family: ui-monospace,monospace; font-size: clamp(.75rem,.76vw,.81rem); font-weight: 600; letter-spacing: .08em; line-height: 1.55; }
  .pipeline-stage p { margin-top: .8rem; color: var(--muted); font-size: clamp(.8rem,.85vw,.9rem); line-height: 1.6; }

  /* ---- Stage glyphs ------------------------------------------------- */
  .stage-glyph { margin-top: 1rem; }
  .stage-glyph svg { display: block; width: 100%; max-width: 5.4rem; height: auto; overflow: visible; }
  .stage-glyph svg * { vector-effect: non-scaling-stroke; }

  .glyph-patches .patch { fill: #2c4762; opacity: .5; transition: fill .4s ease, opacity .4s ease; transition-delay: calc(var(--i) * 34ms); }
  .is-active .glyph-patches .patch { fill: var(--cyan); opacity: .28; }
  .is-active .glyph-patches .patch:nth-child(3n+1) { opacity: .9; }
  .is-active .glyph-patches .patch:nth-child(4n) { opacity: .62; }

  .glyph-embedding .bar { fill: #2c4762; transform-box: fill-box; transform-origin: bottom; transform: scaleY(.12); transition: transform .55s cubic-bezier(.2,.8,.2,1), fill .5s ease; transition-delay: calc(var(--i) * 55ms); }
  .is-active .glyph-embedding .bar { fill: var(--mint); transform: scaleY(1); }
  .is-active .glyph-embedding .bar:nth-child(even) { fill: var(--cyan); }

  .glyph-align .region { fill: none; stroke: #3d5c7a; stroke-width: 1; transition: stroke .5s ease; }
  .glyph-align .token { fill: #2c4762; transform-box: fill-box; transform-origin: left; transform: scaleX(.2); transition: transform .5s cubic-bezier(.2,.8,.2,1) .25s, fill .5s ease; }
  .glyph-align .token-2 { transition-delay: .38s; }
  .glyph-align .token-3 { transition-delay: .5s; }
  .glyph-align .link { stroke: var(--cyan); stroke-width: .9; stroke-dasharray: 24; stroke-dashoffset: 24; transition: stroke-dashoffset .6s ease .1s; }
  .glyph-align .link-2 { transition-delay: .25s; }
  .glyph-align .link-3 { transition-delay: .4s; opacity: .45; }
  .is-active .glyph-align .region { stroke: var(--mint); }
  .is-active .glyph-align .token { fill: var(--cyan); transform: scaleX(1); }
  .is-active .glyph-align .link { stroke-dashoffset: 0; }

  .glyph-branch .edge { fill: none; stroke: #3d5c7a; stroke-width: 1; stroke-dasharray: 30; stroke-dashoffset: 30; transition: stroke-dashoffset .5s ease, stroke .5s ease; }
  .glyph-branch .edge-2, .glyph-branch .edge-3 { transition-delay: .16s; }
  .glyph-branch .edge-4, .glyph-branch .edge-5 { transition-delay: .34s; }
  .glyph-branch .node { fill: #24405c; transition: fill .45s ease; transition-delay: .2s; }
  .is-active .glyph-branch .edge { stroke: var(--cyan); stroke-dashoffset: 0; }
  .is-active .glyph-branch .node { fill: var(--mint); }
  .is-active .glyph-branch .node-5, .is-active .glyph-branch .node-6 { fill: var(--cyan); }

  .glyph-lanes .lane { stroke: #2c4762; stroke-width: 1; }
  .glyph-lanes .packet { fill: var(--cyan); opacity: 0; }
  .is-active .glyph-lanes .packet { opacity: 1; animation: lane-packet 2.6s linear infinite; animation-delay: calc(var(--i) * -.5s); }

  .glyph-validate .ring-track { fill: none; stroke: #2c4762; stroke-width: 1.4; }
  .glyph-validate .ring { fill: none; stroke: var(--mint); stroke-width: 1.4; stroke-linecap: round; stroke-dasharray: 82; stroke-dashoffset: 82; transform-box: fill-box; transform-origin: center; transform: rotate(-90deg); transition: stroke-dashoffset 1s cubic-bezier(.2,.8,.2,1); }
  .glyph-validate .tick { fill: none; stroke: var(--cyan); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 21; stroke-dashoffset: 21; transition: stroke-dashoffset .5s ease .7s; }
  .glyph-validate .cohort { stroke: #2c4762; stroke-width: 1.6; stroke-linecap: round; transition: stroke .5s ease; }
  .is-active .glyph-validate .ring { stroke-dashoffset: 8; }
  .is-active .glyph-validate .tick { stroke-dashoffset: 0; }
  .is-active .glyph-validate .cohort { stroke: #4d7fa8; }
  .is-active .glyph-validate .cohort-2 { stroke: #3d6488; }

  @keyframes lane-packet { from { transform: translateX(1px); } to { transform: translateX(46px); } }

  @media (prefers-reduced-motion: reduce) {
    .glyph-lanes .packet { opacity: 1; animation: none; transform: translateX(24px); }
    .stage-glyph * { transition: none !important; }
    .glyph-embedding .bar { transform: scaleY(1); }
    .glyph-align .token { transform: scaleX(1); }
    .glyph-align .link, .glyph-branch .edge, .glyph-validate .tick { stroke-dashoffset: 0; }
    .glyph-validate .ring { stroke-dashoffset: 8; }
  }

  @media (max-width: 950px) {
    .pipeline-heading { grid-template-columns: 1fr; }
    .pipeline-canvas { grid-template-columns: repeat(2,1fr); }
    .pipeline-stage { min-height: 12rem; }
    .pipeline-stage:nth-child(2n) { border-right: 0; }
    .pipeline-beam { display: none; }
    .pipeline-canvas::after { display: none; }
    .pipeline-stage { opacity: 1; }
  }
  @media (max-width: 560px) {
    .pipeline-canvas { grid-template-columns: 1fr; }
    .pipeline-stage { min-height: 0; display: grid; grid-template-columns: 4.4rem 1fr; gap: 0 1rem; border-right: 0; border-bottom: 1px solid var(--line); padding-block: 1.1rem 1.3rem; }
    .pipeline-stage:last-child { border-bottom: 0; }
    .stage-index { grid-column: 2; }
    .stage-glyph { grid-row: 1 / span 3; margin-top: .2rem; align-self: start; }
    .pipeline-stage h3 { grid-column: 2; margin-top: .5rem; }
    .pipeline-stage p { grid-column: 2; }
  }
</style>
