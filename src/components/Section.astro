---
interface Props {
  id: string;
  className?: string;
}

const { id, className = "" } = Astro.props;
---

<section id={id} class={`scroll-mt-24 py-16 md:py-24 ${className}`}>
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <slot />
  </div>
</section>

<script>
  document.documentElement.classList.add('js');
</script>
