---
import profile from '../data/profile.json';
const base = import.meta.env.BASE_URL;
---

<div class="mx-auto max-w-4xl rounded-lg bg-slate-950 px-6 py-12 text-center text-white md:px-12 md:py-16">
  <p class="section-eyebrow text-blue-200">Contact</p>
  <h2 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">Let's Connect</h2>
  <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-blue-50/80">
    For research collaborations, academic opportunities, or medical AI discussions, reach out by email or LinkedIn.
  </p>

  <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
    <a href={`mailto:${profile.email}`} class="inline-flex items-center gap-3 rounded-md bg-white px-5 py-3 font-bold text-slate-950 transition hover:bg-blue-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
        <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
      </svg>
      Email
    </a>

    <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 rounded-md border border-white/20 px-5 py-3 font-bold text-white transition hover:border-blue-200 hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.239-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
      </svg>
      LinkedIn
    </a>

    <a href={`${base}CV.pdf`} class="inline-flex items-center rounded-md border border-white/20 px-5 py-3 font-bold text-white transition hover:border-blue-200 hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950">
      CV
    </a>
  </div>
</div>
