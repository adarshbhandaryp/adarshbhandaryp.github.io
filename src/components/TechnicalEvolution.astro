---
import evolution from '../data/evolution.json';
---

<section id="evolution" class="section-shell evolution-section section-rule" aria-labelledby="evolution-title">
  <div class="shell">
    <div class="evolution-head reveal">
      <div>
        <p class="section-kicker">04 / TRAJECTORY</p>
        <h2 id="evolution-title" class="section-title">HOW THE WORK EVOLVED</h2>
      </div>
      <p class="section-copy">Each step here was driven by a limitation in the previous one. The order matters more than the count of papers.</p>
    </div>

    <ol class="evolution-track reveal">
      {evolution.map((step, index) => (
        <li>
          <div class="step-marker" aria-hidden="true"><i></i></div>
          <p class="step-period">{step.period}</p>
          <h3>{step.stage}</h3>
          <p class="step-summary">{step.summary}</p>
          <p class="step-anchor">{step.anchor}</p>
          <span class="step-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .evolution-section { background: linear-gradient(180deg,var(--ink),var(--surface) 60%,var(--ink)); }
  .evolution-head { display: grid; grid-template-columns: 1.1fr .9fr; align-items: end; gap: 3rem; }
  .evolution-track { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 1px; margin-top: clamp(3.5rem,7vw,6rem); border: 1px solid var(--line); background: var(--line); }
  .evolution-track li { position: relative; min-width: 0; background: var(--surface); padding: 1.25rem 1.3rem 1.5rem; }
  .step-marker { display: flex; align-items: center; height: 1rem; }
  .step-marker i { width: .55rem; height: .55rem; border: 1px solid var(--cyan); border-radius: 50%; background: var(--ink); }
  .step-period { margin-top: 1.2rem; color: #8ba0b8; font-family: ui-monospace,monospace; font-size: .55rem; letter-spacing: .06em; }
  .evolution-track h3 { margin-top: .6rem; color: var(--mint); font-family: ui-monospace,monospace; font-size: clamp(.58rem,.76vw,.68rem); font-weight: 600; letter-spacing: .08em; line-height: 1.55; }
  .step-summary { margin-top: .95rem; color: var(--muted); font-size: .74rem; line-height: 1.68; }
  .step-anchor { margin-top: 1.1rem; border-top: 1px solid var(--line); padding-top: .8rem; color: #8fa3bb; font-family: ui-monospace,monospace; font-size: .54rem; line-height: 1.5; }
  .step-index { position: absolute; right: 1rem; top: 1rem; color: #8ba0b8; font-family: ui-monospace,monospace; font-size: .55rem; }
  @media (max-width: 1000px) { .evolution-track { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 760px) { .evolution-head { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .evolution-track { grid-template-columns: 1fr; } }
</style>
