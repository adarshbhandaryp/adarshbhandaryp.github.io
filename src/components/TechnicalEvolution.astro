---
import evolution from '../data/evolution.json';
---

<section id="evolution" class="section-shell evolution-section section-rule" aria-labelledby="evolution-title">
  <div class="shell">
    <div class="evolution-head reveal">
      <div>
        <p class="section-kicker">04 / TRAJECTORY</p>
        <h2 id="evolution-title" class="section-title">HOW THE WORK EVOLVED</h2>
      </div>
      <p class="section-copy">Each step here was driven by a limitation in the previous one. The order matters more than the count of papers.</p>
    </div>

    <ol class="evolution-track" data-stagger="80" data-evolution>
      {evolution.map((step, index) => (
        <li data-evolution-step data-index={index}>
          <span class="step-rail" aria-hidden="true"></span>
          <div class="step-marker" aria-hidden="true"><i></i></div>
          <p class="step-period">{step.period}</p>
          <h3>{step.stage}</h3>
          <p class="step-summary">{step.summary}</p>
          <p class="step-anchor">{step.anchor}</p>
          <span class="step-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-evolution-step]'));
  if (steps.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add('is-lit');
      });
    }, { rootMargin: '0px 0px -18%', threshold: .35 });
    steps.forEach((step) => observer.observe(step));
  } else {
    steps.forEach((step) => step.classList.add('is-lit'));
  }
</script>

<style>
  .evolution-section { background: linear-gradient(180deg,var(--ink),var(--surface) 60%,var(--ink)); }
  .evolution-head { display: grid; grid-template-columns: 1.1fr .9fr; align-items: end; gap: 3rem; }
  .evolution-track { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 1px; margin-top: clamp(3rem,6vw,5rem); border: 1px solid var(--line); background: var(--line); }
  .evolution-track li { position: relative; min-width: 0; background: var(--surface); padding: 1.25rem 1.3rem 1.5rem; transition: background .5s ease; }
  .evolution-track li.is-lit { background: linear-gradient(180deg,rgba(50,199,255,.05),var(--surface) 60%); }

  /* The rail draws itself left-to-right as each step scrolls into view. */
  .step-rail { position: absolute; left: 0; top: 0; width: 100%; height: 2px; overflow: hidden; background: rgba(151,178,211,.14); }
  .step-rail::after { position: absolute; inset: 0; content: ''; background: linear-gradient(90deg,var(--cyan),var(--mint)); transform: scaleX(0); transform-origin: 0 50%; transition: transform .9s cubic-bezier(.2,.8,.2,1); }
  .is-lit .step-rail::after { transform: scaleX(1); }

  .step-marker { display: flex; align-items: center; height: 1rem; margin-top: .3rem; }
  .step-marker i { position: relative; width: .55rem; height: .55rem; border: 1px solid var(--cyan); border-radius: 50%; background: var(--ink); transition: background .5s ease .4s, box-shadow .5s ease .4s; }
  .is-lit .step-marker i { background: var(--cyan); box-shadow: 0 0 0 .3rem rgba(50,199,255,.12); }
  .step-period { margin-top: 1.1rem; color: #8ba0b8; font-family: ui-monospace,monospace; font-size: .75rem; letter-spacing: .06em; }
  .evolution-track h3 { margin-top: .6rem; color: var(--mint); font-family: ui-monospace,monospace; font-size: clamp(.75rem,.76vw,.81rem); font-weight: 600; letter-spacing: .08em; line-height: 1.55; }
  .step-summary { margin-top: .9rem; color: var(--muted); font-size: .88rem; line-height: 1.65; }
  .step-anchor { margin-top: 1rem; border-top: 1px solid var(--line); padding-top: .75rem; color: #8fa3bb; font-family: ui-monospace,monospace; font-size: .75rem; line-height: 1.5; }
  .step-index { position: absolute; right: 1rem; top: 1.1rem; color: #8ba0b8; font-family: ui-monospace,monospace; font-size: .75rem; }

  @media (prefers-reduced-motion: reduce) {
    .step-rail::after { transform: scaleX(1); transition: none; }
    .step-marker i { transition: none; }
  }
  @media (max-width: 1000px) { .evolution-track { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 760px) { .evolution-head { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .evolution-track { grid-template-columns: 1fr; } }
</style>
