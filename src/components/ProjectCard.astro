---
interface Props {
  title: string;
  description: string;
  tags: string[];
  link?: string;
}

const { title, description, tags, link = "#" } = Astro.props;
const safeLink = link.startsWith('#http') ? link.slice(1) : link;
---

<a href={safeLink} class="group block h-full rounded-lg border border-slate-200 bg-white p-6 shadow-sm shadow-slate-900/5 transition duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-blue-950/10">
  <div class="flex h-full flex-col">
    <div class="mb-6 h-1 w-16 rounded-full bg-gradient-to-r from-blue-700 to-cyan-400 transition group-hover:w-24"></div>

    <div class="mb-6 flex-1">
      <h3 class="text-2xl font-bold text-slate-950 transition-colors group-hover:text-blue-700">{title}</h3>
      <p class="mt-3 leading-7 text-slate-600">{description}</p>
    </div>

    <div class="mt-auto flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="rounded-full border border-blue-100 bg-blue-50 px-3 py-1 text-xs font-medium text-blue-800">
          {tag}
        </span>
      ))}
    </div>
  </div>
</a>
