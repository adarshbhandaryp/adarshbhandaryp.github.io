---
import graph from '../data/researchGraph.json';

const descriptions: Record<string, string> = {
  'medical-ai': 'Research across mammography, breast MRI, clinical validation, and workflow-aware model design.',
  mammography: 'Large-scale data curation, self-supervised learning, lesion detection, density, report generation, and quality control.',
  'breast-mri': 'Weak slice-level supervision, malignancy classification, explainability, and external clinical evaluation.',
  vlm: 'MammoBLIP, lesion-aware pretraining, medical image-text alignment, and radiological reasoning.',
  'foundation-models': 'Representation learning that connects medical images with language and reusable model capabilities.',
  ssl: 'DINO attention, transfer learning, representation losses, and learning from limited labels.',
  'clinical-ai': 'Validation with radiologists across external cohorts and real screening constraints.',
  hpc: 'GPU clusters, supercomputing infrastructure, distributed training, and optimized inference.',
  llms: 'LLM and multimodal system development, deployment, and application workflows at NHR@FAU.',
  'research-software': 'Reproducible pipelines, AI-powered applications, model APIs, and agentic workflows.',
  nhr: 'Current AI and HPC research environment at FAU.',
  siemens: 'Medical AI research, validation, workflow engineering, and medical-device experience.',
  wch: 'External breast MRI validation and radiologist collaboration in Chengdu.',
};
const nodes = [...graph.topics, ...graph.institutions];
---

<section id="constellation" class="section-shell constellation-section section-rule" aria-labelledby="constellation-title">
  <div class="shell">
    <div class="constellation-head reveal">
      <div><p class="section-kicker">05 / KNOWLEDGE GRAPH</p><h2 id="constellation-title" class="section-title">RESEARCH CONSTELLATION</h2></div>
      <p class="section-copy">A readable map of the ideas, systems, and institutions connected by the work. Select a node to trace its immediate research neighborhood.</p>
    </div>

    <div class="constellation-wrap reveal">
      <div class="constellation-map" data-constellation data-descriptions={JSON.stringify(descriptions)}>
        <svg class="constellation-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          {nodes.flatMap((node) => node.related.map((related) => {
            const target = nodes.find((item) => item.id === related);
            return target ? <line x1={node.x} y1={node.y} x2={target.x} y2={target.y} data-line-from={node.id} data-line-to={target.id}></line> : null;
          }))}
          <line x1="50" y1="50" x2="20" y2="25" data-core-line="medical-ai"></line>
          <line x1="50" y1="50" x2="72" y2="20" data-core-line="vlm"></line>
          <line x1="50" y1="50" x2="83" y2="77" data-core-line="hpc"></line>
          <line x1="50" y1="50" x2="40" y2="18" data-core-line="clinical-ai"></line>
        </svg>
        <button class="constellation-core" type="button" data-node="adarsh" aria-pressed="true"><span>ADARSH</span><small>RESEARCH OS</small></button>
        {nodes.map((node) => (
          <button
            type="button"
            class:list={['constellation-node', `node-${'size' in node ? node.size : 'institution'}`]}
            style={`--x:${node.x}%;--y:${node.y}%`}
            data-node={node.id}
            data-related={node.related.join(',')}
            aria-pressed="false"
          >{node.label}</button>
        ))}
      </div>

      <aside class="constellation-detail" aria-live="polite">
        <p class="mono-label" id="node-type">SELECTED / CORE</p>
        <h3 id="node-title">ADARSH</h3>
        <p id="node-description">Medical AI researcher and AI systems builder connecting data, foundation models, compute infrastructure, and clinical translation.</p>
        <div id="node-related" class="node-related">Medical AI · Vision-Language Models · HPC · Clinical AI</div>
      </aside>
    </div>

    <div class="constellation-mobile" aria-label="Research topic list">
      {graph.topics.map((node) => (
        <details>
          <summary><span>{node.label}</span><b>+</b></summary>
          <p>{descriptions[node.id]}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  const constellation = document.querySelector<HTMLElement>('[data-constellation]');
  const descriptions: Record<string, string> = constellation?.dataset.descriptions ? JSON.parse(constellation.dataset.descriptions) : {};
  const nodes = Array.from(document.querySelectorAll<HTMLButtonElement>('.constellation-node'));
  const lines = Array.from(document.querySelectorAll<SVGLineElement>('.constellation-lines line'));
  const title = document.getElementById('node-title');
  const description = document.getElementById('node-description');
  const related = document.getElementById('node-related');
  const type = document.getElementById('node-type');
  const selectNode = (node: HTMLButtonElement) => {
    const id = node.dataset.node || '';
    const relatedIds = (node.dataset.related || '').split(',');
    nodes.forEach((item) => {
      const connected = item === node || relatedIds.includes(item.dataset.node || '');
      item.classList.toggle('is-active', connected);
      item.classList.toggle('is-muted', !connected);
      item.setAttribute('aria-pressed', String(item === node));
    });
    lines.forEach((line) => {
      const active = line.dataset.lineFrom === id || line.dataset.lineTo === id || relatedIds.includes(line.dataset.lineFrom || '') && line.dataset.lineTo === id;
      line.classList.toggle('is-active', active);
    });
    if (title) title.textContent = node.textContent?.trim() || id;
    if (description) description.textContent = descriptions[id] || 'Connected research area.';
    if (related) related.textContent = relatedIds.map((relatedId) => nodes.find((item) => item.dataset.node === relatedId)?.textContent?.trim()).filter(Boolean).join(' · ');
    if (type) type.textContent = `SELECTED / ${node.classList.contains('node-institution') ? 'INSTITUTION' : 'RESEARCH NODE'}`;
  };
  nodes.forEach((node) => {
    node.addEventListener('mouseenter', () => selectNode(node));
    node.addEventListener('focus', () => selectNode(node));
    node.addEventListener('click', () => selectNode(node));
  });
</script>

<style>
  .constellation-section { background: var(--ink); }
  .constellation-head { display: grid; grid-template-columns: 1.2fr .8fr; align-items: end; gap: 4rem; }
  .constellation-wrap { display: grid; grid-template-columns: minmax(0,1fr) 20rem; gap: 2rem; margin-top: 5rem; }
  .constellation-map { position: relative; aspect-ratio: 16/9.5; min-height: 35rem; border: 1px solid var(--line); overflow: hidden; background: radial-gradient(circle at 50% 50%,rgba(36,124,255,.14),transparent 30%),linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px); background-size: auto,4rem 4rem,4rem 4rem; }
  .constellation-lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .constellation-lines line { vector-effect: non-scaling-stroke; stroke: rgba(87,125,166,.16); stroke-width: .65; transition: stroke .25s ease,stroke-width .25s ease; }
  .constellation-lines line.is-active { stroke: rgba(50,199,255,.65); stroke-width: 1.2; }
  .constellation-core, .constellation-node { position: absolute; z-index: 2; transform: translate(-50%,-50%); border: 1px solid var(--line); border-radius: 50%; background: rgba(17,31,51,.94); color: #c0cde0; text-align: center; box-shadow: 0 0 2rem rgba(0,0,0,.32); transition: opacity .25s ease,border-color .25s ease,color .25s ease,box-shadow .25s ease,transform .25s ease; }
  .constellation-core { left: 50%; top: 50%; display: grid; width: 8.5rem; aspect-ratio: 1; place-content: center; border-color: rgba(124,245,204,.55); color: var(--text); box-shadow: 0 0 3rem rgba(124,245,204,.09); }
  .constellation-core span { font: 600 1.1rem Outfit,sans-serif; }.constellation-core small { color: var(--mint); font: .46rem ui-monospace,monospace; letter-spacing: .14em; }
  .constellation-node { left: var(--x); top: var(--y); width: 6rem; aspect-ratio: 1; padding: .45rem; font-size: .57rem; line-height: 1.3; }
  .node-large { width: 7.2rem; color: #d9e5f4; }.node-small { width: 4.4rem; }.node-institution { width: 5rem; border-style: dashed; color: var(--amber); }
  .constellation-node:hover, .constellation-node.is-active { z-index: 3; transform: translate(-50%,-50%) scale(1.08); border-color: var(--cyan); color: white; box-shadow: 0 0 2.5rem rgba(50,199,255,.18); }
  .constellation-node.is-muted { opacity: .2; }
  .constellation-detail { align-self: end; min-height: 20rem; border-left: 1px solid var(--line-bright); padding: 2rem 0 2rem 2rem; }
  .constellation-detail h3 { margin-top: 1.2rem; font-size: 2.5rem; font-weight: 500; letter-spacing: -.04em; }
  .constellation-detail > p:not(.mono-label) { margin-top: 1.2rem; color: var(--muted); font-size: .9rem; line-height: 1.75; }
  .node-related { margin-top: 2rem; color: var(--cyan); font-family: ui-monospace,monospace; font-size: .58rem; line-height: 1.8; text-transform: uppercase; }
  .constellation-mobile { display: none; margin-top: 3rem; }
  .constellation-mobile details { border-top: 1px solid var(--line); }.constellation-mobile details:last-child { border-bottom: 1px solid var(--line); }
  .constellation-mobile summary { display: flex; justify-content: space-between; padding: 1rem 0; cursor: pointer; list-style: none; }
  .constellation-mobile summary b { color: var(--cyan); }.constellation-mobile details p { padding: 0 0 1rem; color: var(--muted); font-size: .85rem; line-height: 1.7; }
  @media (max-width: 950px) { .constellation-wrap { grid-template-columns: 1fr; }.constellation-detail { min-height: 0; } }
  @media (max-width: 720px) { .constellation-head { grid-template-columns: 1fr; }.constellation-wrap { display: none; }.constellation-mobile { display: block; } }
</style>
