---
import experience from '../data/experience.json';
---

<div class="relative ml-3 space-y-12 border-l border-slate-200 md:ml-6">
  {experience.map((role) => (
    <div class="relative pl-8 md:pl-12">
      <div class="absolute -left-[6px] top-2 h-3 w-3 rounded-full border-2 border-blue-700 bg-white shadow-[0_0_0_6px_rgba(37,99,235,0.08)]"></div>

      <div class="mb-2 flex flex-col gap-2 md:flex-row md:items-baseline">
        <h3 class="text-xl font-bold text-slate-950">{role.role}</h3>
        <span class="text-sm font-semibold text-blue-700">@ {role.company}</span>
      </div>

      <div class="mb-4 flex flex-col gap-2 font-mono text-sm text-slate-500 md:flex-row md:gap-6">
        <span>{role.dates}</span>
        <span class="hidden md:inline">/</span>
        <span>{role.location}</span>
      </div>

      <ul class="space-y-2">
        {role.description.map((item) => (
          <li class="relative pl-4 leading-7 text-slate-600 before:absolute before:left-0 before:text-blue-700 before:content-['-']">
            {item}
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
