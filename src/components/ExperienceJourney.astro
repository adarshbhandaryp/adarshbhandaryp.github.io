---
import experience from '../data/experience.json';
import education from '../data/education.json';
import { sitePath } from '../utils/site';
---

<section id="experience" class="section-shell experience-section section-rule" aria-labelledby="experience-title">
  <div class="shell">
    <div class="experience-head reveal">
      <div>
        <p class="section-kicker">06 / EXPERIENCE</p>
        <h2 id="experience-title" class="section-title">WHERE THE WORK HAPPENED</h2>
      </div>
      <div>
        <p class="section-copy">Medical devices, then clinical AI inside a manufacturer, then a hospital cohort, then a supercomputing centre. Each move added a constraint the previous one did not have.</p>
        <a href={sitePath('cv/')} class="text-link">Full CV</a>
      </div>
    </div>

    <ol class="role-list reveal">
      {experience.map((role) => (
        <li>
          <div class="role-when">
            <p class="role-phase">{role.phase}</p>
            <p class="role-dates">{role.dates}</p>
            <p class="role-location">{role.location}</p>
          </div>
          <div class="role-what">
            <h3>{role.role}</h3>
            <p class="role-company">{role.company}</p>
            <ul>{role.description.map((item) => <li>{item}</li>)}</ul>
          </div>
        </li>
      ))}
    </ol>

    <div class="education reveal">
      <p class="mono-label">EDUCATION</p>
      <div>
        {education.map((item) => (
          <article>
            <h3>{item.degree}</h3>
            <p>{item.school}</p>
            <small>{item.dates}</small>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .experience-section { background: linear-gradient(180deg,var(--ink),var(--surface)); }
  .experience-head { display: grid; grid-template-columns: 1.1fr .9fr; align-items: end; gap: 3rem; }
  .experience-head .text-link { margin-top: 1.4rem; }
  .role-list { margin-top: clamp(3rem,6vw,5rem); border-top: 1px solid var(--line); }
  .role-list > li { display: grid; grid-template-columns: 15rem minmax(0,1fr); gap: clamp(1.5rem,4vw,4rem); border-bottom: 1px solid var(--line); padding-block: 1.9rem 2.1rem; }
  .role-when { position: relative; }
  .role-phase { color: var(--mint); font-family: ui-monospace,monospace; font-size: .62rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .role-dates { margin-top: .7rem; color: #cbd8e8; font-family: ui-monospace,monospace; font-size: .62rem; }
  .role-location { margin-top: .35rem; color: #8ba0b8; font-family: ui-monospace,monospace; font-size: .62rem; }
  .role-what h3 { font-size: clamp(1.25rem,2.2vw,1.7rem); font-weight: 500; letter-spacing: -.02em; }
  .role-company { margin-top: .45rem; color: var(--cyan); font-size: .78rem; }
  .role-what ul { display: grid; gap: .55rem; margin-top: 1.2rem; }
  .role-what li { position: relative; max-width: 52rem; color: var(--muted); font-size: .8rem; line-height: 1.72; padding-left: 1.1rem; }
  .role-what li::before { position: absolute; left: 0; top: .1rem; content: '—'; color: #8ba0b8; }
  .education { margin-top: clamp(3rem,6vw,5rem); }
  .education > div { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; margin-top: 1rem; border: 1px solid var(--line); background: var(--line); }
  .education article { background: var(--surface); padding: 1.2rem; }
  .education h3 { font-size: .92rem; font-weight: 500; line-height: 1.35; }
  .education p { margin-top: .55rem; color: var(--muted); font-size: .74rem; line-height: 1.55; }
  .education small { display: block; margin-top: .7rem; color: #8ba0b8; font-family: ui-monospace,monospace; font-size: .62rem; }
  @media (max-width: 860px) {
    .experience-head { grid-template-columns: 1fr; }
    .role-list > li { grid-template-columns: 1fr; gap: 1rem; }
    .education > div { grid-template-columns: 1fr; }
  }
</style>
