---
import experience from '../data/experience.json';
import { sitePath } from '../utils/site';

const journey = [...experience].reverse();
---

<section id="experience" class="section-shell experience-section section-rule" aria-labelledby="experience-title">
  <div class="shell">
    <div class="experience-head reveal">
      <div><p class="section-kicker">06 / TRAJECTORY</p><h2 id="experience-title" class="section-title">FROM DEVICES TO AI SYSTEMS</h2></div>
      <div><p class="section-copy">A progression shaped by the constraints of medical devices, clinical workflows, deep learning research, external validation, foundation models, and large-scale compute.</p><a href={sitePath('cv/')} class="text-link">Open full CV</a></div>
    </div>

    <div class="journey-map reveal">
      <div class="journey-line" aria-hidden="true"></div>
      {journey.map((role, index) => (
        <article class="journey-stop">
          <div class="journey-node"><i></i><span>0{index + 1}</span></div>
          <p class="journey-phase">{role.phase}</p>
          <h3>{role.company}</h3>
          <h4>{role.role}</h4>
          <p class="journey-date">{role.dates} / {role.location}</p>
          <p data-research-copy>{role.description[0]}</p>
          <p data-recruiter-copy data-nosnippet>{role.recruiterSummary}</p>
        </article>
      ))}
    </div>
    <p class="journey-hint mono-label">DRAG / SCROLL TO TRACE THE JOURNEY →</p>
  </div>
</section>

<style>
  .experience-section { overflow: hidden; background: linear-gradient(180deg,#050810,#07101b); }
  .experience-head { display: grid; grid-template-columns: 1.2fr .8fr; align-items: end; gap: 4rem; }
  .experience-head .text-link { margin-top: 1.5rem; }
  .journey-map { position: relative; display: grid; grid-auto-columns: minmax(17rem,1fr); grid-auto-flow: column; gap: 1px; margin-top: clamp(4rem,9vw,8rem); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; }
  .journey-line { position: absolute; left: 0; right: 0; top: 2.1rem; height: 1px; background: linear-gradient(90deg,#29445d,var(--cyan),var(--mint)); }
  .journey-stop { position: relative; min-height: 24rem; scroll-snap-align: start; border-left: 1px solid var(--line); padding: 1.25rem 1.5rem 2rem; background: linear-gradient(180deg,rgba(50,199,255,.035),transparent 30%); }
  .journey-node { position: relative; display: flex; height: 2rem; align-items: center; gap: .7rem; }
  .journey-node i { width: .65rem; height: .65rem; border: 1px solid var(--cyan); border-radius: 50%; background: var(--ink); box-shadow: 0 0 1rem rgba(50,199,255,.5); }
  .journey-node span { color: #59718c; font-family: ui-monospace,monospace; font-size: .55rem; }
  .journey-phase { margin-top: 2.2rem; color: var(--mint); font-family: ui-monospace,monospace; font-size: .58rem; letter-spacing: .1em; text-transform: uppercase; }
  .journey-stop h3 { margin-top: .85rem; font-size: 1.55rem; font-weight: 500; line-height: 1.05; }
  .journey-stop h4 { margin-top: .65rem; color: #c1cedd; font-size: .8rem; font-weight: 500; }
  .journey-date { min-height: 2.8rem; margin-top: .75rem; color: #667c95; font-family: ui-monospace,monospace; font-size: .55rem; line-height: 1.5; text-transform: uppercase; }
  .journey-stop > p:last-child, .journey-stop > p:nth-last-child(2) { margin-top: 1.4rem; color: var(--muted); font-size: .78rem; line-height: 1.7; }
  [data-recruiter-copy] { display: none; }:global(body[data-mode='recruiter']) [data-research-copy] { display: none; }:global(body[data-mode='recruiter']) [data-recruiter-copy] { display: block; }
  .journey-hint { margin-top: 1rem; text-align: right; color: #566d86; }
  @media (max-width: 760px) { .experience-head { grid-template-columns: 1fr; }.journey-map { margin-inline: -.65rem; padding-inline: .65rem; }.journey-hint { text-align: left; } }
</style>
