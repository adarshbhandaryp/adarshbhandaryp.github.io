---
import profile from '../data/profile.json';
import { sitePath } from '../utils/site';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <a href={sitePath()} class="footer-mark">{profile.navName}</a>
    <p>© {currentYear} {profile.name} · {profile.location}</p>
    <a href="#main-content">Back to top ↑</a>
  </div>
</footer>

<style>
  .footer-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; min-height: 6rem; font-family: ui-monospace,monospace; font-size: .62rem; letter-spacing: .06em; }
  .footer-mark { color: white; font-family: Outfit,sans-serif; font-size: .78rem; font-weight: 600; letter-spacing: .04em; }
  .footer-inner > a:last-child { justify-self: end; }
  .footer-inner a:hover { color: var(--cyan); }
  @media (max-width: 600px) { .footer-inner { grid-template-columns: 1fr auto; }.footer-inner p { grid-column: 1/-1; grid-row: 2; padding-bottom: 1rem; } }
</style>
