---
import skills from '../data/skills.json';
---

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {skills.map((skillGroup) => (
    <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm shadow-slate-900/5">
      <h3 class="mb-4 border-b border-slate-100 pb-3 text-lg font-bold text-slate-950">{skillGroup.category}</h3>
      <div class="flex flex-wrap gap-2">
        {skillGroup.items.map((skill) => (
          <span class="cursor-default rounded-md border border-slate-200 bg-slate-50 px-3 py-1 text-sm text-slate-700 transition hover:border-blue-200 hover:text-blue-800">
            {skill}
          </span>
        ))}
      </div>
    </div>
  ))}
</div>
