---
import { talkPhotos } from '../data/gallery';
import { sitePath } from '../utils/site';

interface Props {
  /** Section kicker, e.g. "08 / TALKS". */
  kicker?: string;
  /** Anchor id for in-page navigation. */
  id?: string;
  /** Show a link through to the dedicated talks page. */
  showLink?: boolean;
}
const { kicker = 'TALKS', id = 'talks', showLink = false } = Astro.props;

const meta = [
  { title: 'Attention-Guided Erasing', event: 'BVM', city: 'Erlangen', year: '2024' },
  { title: 'Dataset-Informed Transfer Learning', event: 'CVIP', city: 'Rupnagar', year: '2025' },
  { title: 'MammoBLIP', event: 'IEEE MIC', city: 'Yokohama', year: '2025' },
  { title: 'Representation Learning for CESM', event: 'SPIE Medical Imaging', city: 'San Diego', year: '2024' },
  { title: 'Pattern Recognition Symposium', event: 'PRS', city: 'Austria', year: '2025' },
];
---

<section id={id} class="section-shell gallery-section section-rule" aria-labelledby="gallery-title">
  <div class="shell">
    <div class="gallery-head reveal">
      <div><p class="section-kicker">{kicker}</p><h2 id="gallery-title" class="section-title">PRESENTING THE WORK</h2></div>
      <div>
        <p class="section-copy">Oral presentations at BVM, SPIE Medical Imaging, IEEE MIC, CVIP and the Pattern Recognition Symposium.</p>
        {showLink && <a href={sitePath('talks/')} class="text-link gallery-link">All talks</a>}
      </div>
    </div>
    <div class="editorial-gallery" data-stagger="90">
      {talkPhotos.map((photo, index) => (
        <button type="button" class="gallery-item" data-gallery-index={index} aria-label={`Open image: ${photo.caption}`}>
          <img src={photo.src} alt={photo.alt} loading="lazy" width="1200" height="1600" />
          <span class="gallery-overlay"><small>{meta[index]?.event} / {meta[index]?.year}</small><strong>{meta[index]?.title}</strong><i>{meta[index]?.city}</i></span>
          <b>0{index + 1}</b>
        </button>
      ))}
    </div>
      <p class="gallery-hint">Scroll sideways for all {talkPhotos.length} — click any photo to enlarge.</p>
  </div>
</section>

<div id="lightbox" class="dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="lightbox-caption" hidden>
  <div class="gallery-lightbox">
    <button id="close-lightbox" type="button" aria-label="Close image">ESC / CLOSE</button>
    <img id="lightbox-img" alt="" />
    <p id="lightbox-caption"></p>
  </div>
</div>

<script>
  import { talkPhotos } from '../data/gallery';
  const lightbox = document.getElementById('lightbox');
  const lightboxImage = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const caption = document.getElementById('lightbox-caption');
  const closeButton = document.getElementById('close-lightbox');
  const close = () => { lightbox?.setAttribute('hidden',''); document.body.style.overflow = ''; };
  document.querySelectorAll<HTMLElement>('[data-gallery-index]').forEach((item) => item.addEventListener('click', () => {
    const photo = talkPhotos[Number(item.dataset.galleryIndex)];
    if (!photo || !lightboxImage || !caption) return;
    lightboxImage.src = photo.src; lightboxImage.alt = photo.alt; caption.textContent = photo.caption;
    lightbox?.removeAttribute('hidden'); document.body.style.overflow = 'hidden'; closeButton?.focus();
  }));
  closeButton?.addEventListener('click', close);
  lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) close(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !lightbox?.hasAttribute('hidden')) close(); });
</script>

<style>
  .gallery-section { overflow: hidden; background: var(--ink); }
  .gallery-head { display: grid; grid-template-columns: 1.2fr .8fr; align-items: end; gap: 4rem; }
  .gallery-link { margin-top: 1.4rem; }
  .editorial-gallery { display: grid; grid-auto-columns: minmax(20rem,28rem); grid-auto-flow: column; gap: 1rem; margin-top: clamp(3rem,6vw,5rem); overflow-x: auto; padding-bottom: 1rem; scroll-snap-type: x mandatory; }
  .gallery-hint { display: flex; align-items: center; gap: .45rem; margin-top: .5rem; color: #8ba0b8; font-family: ui-monospace,monospace; font-size: .75rem; letter-spacing: .06em; }
  .gallery-hint::after { content: '→'; color: var(--cyan); animation: hint-nudge 2.4s ease-in-out infinite; }
  @keyframes hint-nudge { 0%,100% { transform: translateX(0); opacity: .55; } 50% { transform: translateX(.3rem); opacity: 1; } }
  .gallery-item { position: relative; aspect-ratio: 1/1; overflow: hidden; scroll-snap-align: start; text-align: left; background: var(--surface); }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: grayscale(.18) saturate(.95); transition: transform 1s ease,filter .6s ease; }
  .gallery-item:hover img, .gallery-item:focus-visible img { transform: scale(1.03); filter: none; }
  .gallery-item::after { position: absolute; inset: 0; content: ''; background: linear-gradient(to top,rgba(3,6,12,.94) 0%,rgba(3,6,12,.8) 26%,rgba(3,6,12,.34) 44%,transparent 62%); }
  .gallery-overlay { position: absolute; z-index: 2; inset: auto 1.4rem 1.4rem; display: grid; gap: .45rem; }.gallery-overlay small { color: #8fe3ff; font-family: ui-monospace,monospace; font-size: .75rem; letter-spacing: .12em; text-shadow: 0 1px 3px rgba(0,0,0,.85); }.gallery-overlay strong { font: 500 clamp(1.25rem,2.2vw,1.75rem) Outfit,sans-serif; line-height: 1.1; text-shadow: 0 1px 4px rgba(0,0,0,.8); }.gallery-overlay i { color: #c8d6e6; font-size: .83rem; font-style: normal; text-shadow: 0 1px 3px rgba(0,0,0,.85); }
  .gallery-item > b { position: absolute; z-index: 2; right: 1rem; top: 1rem; color: white; font-family: ui-monospace,monospace; font-size: .75rem; text-shadow: 0 1px 4px rgba(0,0,0,.9); }
  .gallery-lightbox { display: grid; max-height: 92vh; width: min(100%,65rem); grid-template-columns: 1fr auto; gap: .8rem; }.gallery-lightbox button { grid-column: 2; color: var(--cyan); font-family: ui-monospace,monospace; font-size: .75rem; }.gallery-lightbox img { grid-column: 1/-1; max-height: 78vh; width: 100%; object-fit: contain; background: #050810; }.gallery-lightbox p { grid-column: 1/-1; color: var(--muted); font-size: .94rem; }
  @media (max-width: 720px) { .gallery-head { grid-template-columns: 1fr; }.editorial-gallery { grid-auto-columns: 82vw; margin-inline: -.65rem; padding-inline: .65rem; } }
</style>
