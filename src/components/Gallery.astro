---
import { talkPhotos } from '../data/gallery';
---

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {talkPhotos.map((photo, index) => (
    <button class="group relative aspect-video overflow-hidden rounded-lg border border-white/10 bg-white/5 text-left shadow-lg shadow-slate-950/20" data-gallery-index={index} aria-label={`Open image: ${photo.caption}`}>
      <img
        src={photo.src}
        alt={photo.alt}
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        loading="lazy"
      />

      <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/90 to-transparent p-4 text-sm font-semibold text-white opacity-100">
        {photo.caption}
      </span>
    </button>
  ))}
</div>

<div id="lightbox" class="pointer-events-none fixed inset-0 z-50 flex items-center justify-center bg-slate-950/95 opacity-0 transition-opacity duration-300">
  <button id="close-lightbox-btn" class="absolute right-5 top-5 rounded-md p-2 text-white/70 transition hover:bg-white/10 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-300" aria-label="Close image">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <div class="flex max-h-screen max-w-7xl flex-col items-center p-4">
    <img id="lightbox-img" src="" alt="" class="max-h-[80vh] max-w-full rounded-lg shadow-2xl" />
    <p id="lightbox-caption" class="mt-4 text-center text-lg font-medium text-white"></p>
  </div>
</div>

<script>
  import { talkPhotos } from '../data/gallery';

  function openLightbox(src: string, caption: string, alt: string) {
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption');

    if (lightbox && lightboxImg && lightboxCaption) {
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      lightboxCaption.textContent = caption;
      lightbox.classList.remove('opacity-0', 'pointer-events-none');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeLightbox() {
    const lightbox = document.getElementById('lightbox');
    if (lightbox) {
      lightbox.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
    }
  }

  function setupGallery() {
    document.querySelectorAll<HTMLElement>('[data-gallery-index]').forEach((item) => {
      item.addEventListener('click', () => {
        const index = Number(item.dataset.galleryIndex);
        const photo = talkPhotos[index];
        if (photo) openLightbox(photo.src, photo.caption, photo.alt);
      });
    });

    document.getElementById('close-lightbox-btn')?.addEventListener('click', closeLightbox);
    document.getElementById('lightbox')?.addEventListener('click', (event) => {
      if (event.target instanceof HTMLElement && event.target.id === 'lightbox') closeLightbox();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeLightbox();
    });
  }

  setupGallery();
  document.addEventListener('astro:page-load', setupGallery);
</script>
