---
import { sitePath } from '../utils/site';

const prompts = [
  'What has he done with LLMs and VLMs?',
  'What did he work on at Siemens Healthineers?',
  'Which papers should I read first?',
  'What is his experience with GPUs and HPC?',
  'Which work involves vision-language models?',
  'Has he worked with real clinical data?',
];

const answers = [
  {
    keywords: ['llm', 'large language', 'agent', 'foundation model api'],
    answer: 'At NHR@FAU, Adarsh prototypes applications around locally deployed LLM and VLM runtimes, foundation-model APIs, retrieval pipelines, and tool-using agent workflows, with GPU-backed training and inference infrastructure.',
    label: 'See AI systems work', href: sitePath('#systems'),
  },
  {
    keywords: ['hpc', 'gpu', 'cluster', 'slurm', 'supercomput', 'distributed', 'scale'],
    answer: 'Adarsh is a Research Scientist at NHR@FAU working across AI and high-performance computing. He designs scalable training and inference pipelines on GPU clusters and supercomputing infrastructure, and has built reproducible deep-learning pipelines with Docker and SLURM.',
    label: 'Explore AI systems work', href: sitePath('#systems'),
  },
  {
    keywords: ['siemens', 'healthineers', 'medical device'],
    answer: 'Across Siemens Healthineers roles from 2017 to 2024, Adarsh worked on clinical AI validation, mammography workflow optimization, positioning-artifact classification, data annotation with radiologists, medical-device workflows, and a secure device-unlocking patent.',
    label: 'Trace the experience journey', href: sitePath('#experience'),
  },
  {
    keywords: ['vlm', 'vision-language', 'vision language', 'mammoblip', 'multimodal', 'report'],
    answer: 'His vision-language work includes MammoBLIP for mammography report generation, mammography foundation models for radiological reasoning, lesion-aware image-text pretraining, and current multimodal AI systems work at NHR@FAU.',
    label: 'Read about MammoBLIP', href: sitePath('publications/mammoblip-mammography-report-generation/'),
  },
  {
    keywords: ['mri', 'be-wise', 'odelia'],
    answer: 'His breast MRI work is BE-WISE and BE-WISER: weakly supervised three-class diagnosis plus slice-level lesion localization from a single annotated slice per examination, built and benchmarked on the multicenter ODELIA Breast MRI dataset. Separately, he evaluated a Siemens breast MRI research prototype on an external West China Hospital cohort.',
    label: 'Explore MRI research', href: sitePath('publications/be-wise-breast-mri-explanation/'),
  },
  {
    keywords: ['clinical', 'validation', 'radiologist', 'hospital', 'west china', 'vietnam'],
    answer: 'Adarsh has evaluated mammography AI in an international Vietnamese cohort and helped validate a breast MRI AI prototype on West China Hospital data. That work involved radiologists, external cohorts, annotation quality, screening workflows, and real clinical constraints.',
    label: 'See clinical validation study', href: sitePath('publications/ai-performance-breast-lesions-mri-chinese-cohort/'),
  },
  {
    keywords: ['project', 'strongest', 'research', 'medical ai', 'mammography', 'foundation'],
    answer: 'The four flagship pieces are attention-guided erasing (self-supervised representation learning, IJCARS 2025), MammoBLIP (mammography report generation, IEEE MIC 2025), BE-WISE (weakly supervised breast MRI, BVM 2026), and the dataset-informed transfer learning framework. Alongside those: a curated 81,076-image multi-institutional mammography corpus and retrospective clinical evaluations in Vietnam and China.',
    label: 'Explore featured research', href: sitePath('#research'),
  },
];
---

<div id="ask-dialog" class="dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="ask-title" hidden data-answers={JSON.stringify(answers)} data-publications-path={sitePath('publications/')} data-nosnippet>
  <div class="dialog-panel ask-panel">
    <header class="ask-header">
      <div><span class="ask-pulse" aria-hidden="true"></span><div><p>Answers built from this site</p><h2 id="ask-title">ASK ADARSH</h2></div></div>
      <button type="button" id="close-ask" aria-label="Close Ask Adarsh">ESC</button>
    </header>
    <div class="ask-body" id="ask-body" aria-live="polite">
      <div class="assistant-message">
        <span>Adarsh</span>
        <p>Ask about Adarsh's research, experience, publications, or technical capabilities, then follow the evidence into the portfolio.</p>
      </div>
      <div class="suggested-prompts" id="suggested-prompts">
        {prompts.map((prompt) => <button type="button" data-question={prompt}>{prompt}</button>)}
      </div>
      <div id="answer-thread"></div>
    </div>
    <form class="ask-input" id="ask-form">
      <label class="sr-only" for="ask-question">Ask a question about Adarsh</label>
      <span aria-hidden="true">›</span>
      <input id="ask-question" name="question" autocomplete="off" placeholder="Ask about MRI, VLMs, Siemens, HPC…" />
      <button type="submit">SEND ↗</button>
    </form>
    <footer class="ask-footer"><span>Nothing you type leaves your browser</span><span>Research · experience · publications</span></footer>
  </div>
</div>

<script>
  type Answer = { keywords: string[]; answer: string; label: string; href: string };
  const dialog = document.getElementById('ask-dialog');
  const closeButton = document.getElementById('close-ask');
  const form = document.getElementById('ask-form') as HTMLFormElement | null;
  const input = document.getElementById('ask-question') as HTMLInputElement | null;
  const thread = document.getElementById('answer-thread');
  const answers: Answer[] = dialog?.dataset.answers ? JSON.parse(dialog.dataset.answers) : [];
  let lastFocus: HTMLElement | null = null;

  const openAsk = () => {
    lastFocus = document.activeElement as HTMLElement;
    dialog?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    window.setTimeout(() => input?.focus(), 20);
  };
  const closeAsk = () => {
    dialog?.setAttribute('hidden', '');
    document.body.style.overflow = '';
    lastFocus?.focus();
  };
  const answerQuestion = (question: string) => {
    const normalized = question.toLowerCase();
    const scored = answers.map((answer) => ({ answer, score: answer.keywords.reduce((score, keyword) => score + (normalized.includes(keyword) ? keyword.length : 0), 0) })).sort((a,b) => b.score - a.score);
    const match = scored[0]?.score > 0 ? scored[0].answer : {
      answer: 'I could not match that precisely in the public site data. Try asking about medical AI, mammography, breast MRI, vision-language models, Siemens, clinical validation, LLMs, or HPC.',
      label: 'Browse all publications', href: dialog?.dataset.publicationsPath || '/'
    };
    if (!thread) return;
    const user = document.createElement('div'); user.className = 'user-message'; user.textContent = question;
    const response = document.createElement('div'); response.className = 'assistant-message';
    const label = document.createElement('span'); label.textContent = 'Adarsh';
    const copy = document.createElement('p'); copy.textContent = match.answer;
    const link = document.createElement('a'); link.href = match.href; link.textContent = `${match.label} →`;
    response.append(label, copy, link); thread.append(user, response);
    user.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  };

  window.addEventListener('open-ask-adarsh', openAsk);
  document.querySelectorAll('[data-open-ask]').forEach((button) => button.addEventListener('click', openAsk));
  closeButton?.addEventListener('click', closeAsk);
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) closeAsk(); });
  document.querySelectorAll<HTMLButtonElement>('[data-question]').forEach((button) => button.addEventListener('click', () => answerQuestion(button.dataset.question || '')));
  form?.addEventListener('submit', (event) => { event.preventDefault(); if (input?.value.trim()) { answerQuestion(input.value.trim()); input.value = ''; } });
  document.addEventListener('keydown', (event) => {
    if (dialog?.hasAttribute('hidden')) return;
    if (event.key === 'Escape') closeAsk();
    if (event.key === 'Tab') {
      const focusable = Array.from(dialog.querySelectorAll<HTMLElement>('button,input,a[href]'));
      const first = focusable[0], last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
  });
</script>

<style>
  .ask-panel { display: grid; grid-template-rows: auto minmax(0,1fr) auto auto; height: min(85vh,48rem); }
  .ask-header { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); padding: 1rem 1.2rem; }.ask-header > div { display: flex; align-items: center; gap: .8rem; }.ask-header p,.ask-footer { color: #8ba0b8; font-family: ui-monospace,monospace; font-size: .62rem; letter-spacing: .11em; }.ask-header h2 { margin-top: .2rem; font-size: 1rem; letter-spacing: .03em; }.ask-header > button { border: 1px solid var(--line); border-radius: .2rem; color: var(--muted); padding: .3rem .45rem; font-family: ui-monospace,monospace; font-size: .62rem; }
  .ask-pulse { width: .55rem; height: .55rem; border-radius: 50%; background: var(--mint); box-shadow: 0 0 1rem var(--mint); animation: ask-pulse 2s ease-in-out infinite; }
  .ask-body { overflow-y: auto; padding: 1.2rem; }.assistant-message { max-width: 88%; border-left: 1px solid var(--cyan); background: #0d1828; padding: 1rem 1.1rem; }.assistant-message span { color: var(--cyan); font-family: ui-monospace,monospace; font-size: .62rem; letter-spacing: .1em; }.assistant-message p { margin-top: .55rem; color: #c1cede; font-size: .8rem; line-height: 1.7; }.assistant-message a { display: inline-block; margin-top: .8rem; color: var(--mint); font-size: .68rem; font-weight: 600; }
  .suggested-prompts { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1rem; }.suggested-prompts button { border: 1px solid var(--line); border-radius: .2rem; color: #9eafc4; padding: .55rem .7rem; font-size: .65rem; text-align: left; transition: border-color .2s,color .2s; }.suggested-prompts button:hover { border-color: var(--cyan); color: white; }
  #answer-thread { display: grid; gap: 1rem; margin-top: 1.3rem; }.user-message { justify-self: end; max-width: 82%; background: #183152; padding: .7rem .9rem; color: #e2edfa; font-size: .75rem; line-height: 1.5; }
  .ask-input { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .6rem; border-top: 1px solid var(--line); padding: .8rem 1rem; }.ask-input > span { color: var(--cyan); }.ask-input input { min-width: 0; border: 0; outline: 0; background: transparent; color: white; font-size: .8rem; }.ask-input button { color: var(--cyan); font-family: ui-monospace,monospace; font-size: .62rem; }
  .ask-footer { display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding: .55rem 1rem; }
  @keyframes ask-pulse { 50% { opacity: .35; } }
  @media (max-width: 520px) { .ask-panel { height: 92vh; max-height: 92vh; }.suggested-prompts { display: grid; }.ask-footer span:last-child { display: none; } }
</style>
