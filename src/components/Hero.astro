---
import profile from '../data/profile.json';
import expertise from '../data/expertise.json';
import { sitePath } from '../utils/site';

const concepts = [
  'SELF-SUPERVISION',
  'MULTIMODALITY',
  'REPRESENTATION',
  'VISION + LANGUAGE',
  'RETRIEVAL',
  'REASONING',
  'CLINICAL AI',
];
---

<section class="hero" aria-labelledby="hero-title">
  <canvas id="research-field" class="research-field" aria-hidden="true"></canvas>
  <div class="hero-grid grid-field" aria-hidden="true"></div>
  <div class="hero-orbit orbit-a" aria-hidden="true"></div>

  <div class="shell hero-layout">
    <div class="hero-copy">
      <p class="hero-eyebrow">{profile.affiliations[0]}<br />{profile.affiliations[1]}</p>
      <h1 id="hero-title">
        <span>ADARSH</span>
        <span>BHANDARY</span>
        <span>PANAMBUR</span>
      </h1>
      <p class="hero-role">{profile.role}</p>
      <p class="hero-statement">{profile.tagline}</p>
      <div class="hero-actions">
        <a href="#research" class="btn-primary magnetic">See the research <span aria-hidden="true">↓</span></a>
        <a href={sitePath('publications/')} class="btn-secondary magnetic">Publications</a>
        <a href={sitePath('CV.pdf')} class="btn-ghost">CV (PDF) <span aria-hidden="true">↘</span></a>
      </div>
      <div class="hero-social">
        <a href={profile.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={`mailto:${profile.email}`}>Email</a>
      </div>
    </div>

    <div class="portrait-stage">
      <div class="portrait-frame">
        <img src={sitePath('profile_photo.webp')} alt={`Portrait of ${profile.name}`} width="1200" height="1800" fetchpriority="high" />
        <div class="portrait-mind" aria-hidden="true">
          <svg class="mind-map" viewBox="0 0 400 560" preserveAspectRatio="none">
            <path class="mind-path mind-path-a" d="M19 191 C63 163 72 100 124 73 S230 23 286 61 S350 120 378 88" />
            <path class="mind-path mind-path-b" d="M286 61 C329 79 343 120 331 164 S331 221 376 244" />
            <path class="mind-path mind-path-c" d="M39 247 C75 213 98 202 132 196 S177 164 176 124" />
            <path class="mind-path mind-path-d" d="M331 164 C298 172 281 194 276 226 S297 277 359 293" />
            <path class="mind-echo" d="M76 104 C111 51 176 28 234 38" />
            <path class="mind-echo" d="M304 210 C330 231 349 235 383 227" />
            <g class="mind-node node-a"><circle class="node-orbit" cx="124" cy="73" r="9" /><circle class="node-core" cx="124" cy="73" r="2.5" /></g>
            <g class="mind-node node-b"><circle class="node-orbit" cx="286" cy="61" r="11" /><circle class="node-core" cx="286" cy="61" r="3" /></g>
            <g class="mind-node node-c"><circle class="node-orbit" cx="331" cy="164" r="7" /><circle class="node-core" cx="331" cy="164" r="2.2" /></g>
            <g class="mind-node node-d"><circle class="node-orbit" cx="132" cy="196" r="6" /><circle class="node-core" cx="132" cy="196" r="2" /></g>
            <circle class="mind-dot" cx="62" cy="166" r="1.8" />
            <circle class="mind-dot" cx="176" cy="124" r="1.8" />
            <circle class="mind-dot" cx="276" cy="226" r="1.8" />
            <circle class="mind-dot" cx="359" cy="293" r="1.8" />
          </svg>
          <span class="mind-label" data-concept-label data-concepts={concepts.join('|')}>{concepts[0]}</span>
        </div>
      </div>
      <p class="portrait-caption">{profile.location}</p>
    </div>
  </div>

  <div class="shell expertise-strip" aria-label="Areas of expertise">
    {expertise.map((item) => (
      <article class="expertise-cell">
        <p class="expertise-title">{item.title}</p>
        <p class="expertise-detail">{item.detail}</p>
      </article>
    ))}
  </div>
</section>

<script>
  const canvas = document.getElementById('research-field') as HTMLCanvasElement | null;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canvas) {
    const context = canvas.getContext('2d');
    const pointer = { x: .7, y: .35 };
    const nodes = Array.from({ length: 34 }, (_, index) => ({
      x: ((index * 47) % 101) / 100,
      y: ((index * 73) % 97) / 100,
      r: index % 9 === 0 ? 1.9 : .85,
      speed: .00007 + (index % 5) * .000015,
      phase: index * .83,
    }));
    let frame = 0;
    const resize = () => {
      const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
      canvas.width = Math.floor(canvas.clientWidth * ratio);
      canvas.height = Math.floor(canvas.clientHeight * ratio);
      context?.setTransform(ratio, 0, 0, ratio, 0, 0);
    };
    const draw = (time = 0) => {
      if (!context) return;
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      context.clearRect(0, 0, width, height);
      const positions = nodes.map((node) => ({
        x: node.x * width + Math.sin(time * node.speed + node.phase) * 12 + (pointer.x - .5) * (node.r * 5),
        y: node.y * height + Math.cos(time * node.speed + node.phase) * 9 + (pointer.y - .5) * (node.r * 5),
        r: node.r,
      }));
      positions.forEach((node, index) => {
        positions.slice(index + 1).forEach((other) => {
          const distance = Math.hypot(node.x - other.x, node.y - other.y);
          if (distance < 145) {
            context.beginPath();
            context.moveTo(node.x, node.y);
            context.lineTo(other.x, other.y);
            context.strokeStyle = `rgba(74, 178, 255, ${.075 * (1 - distance / 145)})`;
            context.lineWidth = .6;
            context.stroke();
          }
        });
        context.beginPath();
        context.arc(node.x, node.y, node.r, 0, Math.PI * 2);
        context.fillStyle = node.r > 1.5 ? 'rgba(124,245,204,.55)' : 'rgba(80,190,255,.32)';
        context.fill();
      });
      if (!reduceMotion) frame = requestAnimationFrame(draw);
    };
    resize();
    draw();
    window.addEventListener('resize', resize, { passive: true });
    window.addEventListener('pointermove', (event) => { pointer.x = event.clientX / window.innerWidth; pointer.y = event.clientY / window.innerHeight; }, { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(frame);
      else if (!reduceMotion) frame = requestAnimationFrame(draw);
    });
  }

  const conceptLabel = document.querySelector<HTMLElement>('[data-concept-label]');
  if (conceptLabel && !reduceMotion) {
    const concepts = (conceptLabel.dataset.concepts || '').split('|').filter(Boolean);
    let conceptIndex = 0;
    setInterval(() => {
      conceptIndex = (conceptIndex + 1) % concepts.length;
      conceptLabel.classList.add('is-swapping');
      window.setTimeout(() => {
        conceptLabel.textContent = concepts[conceptIndex];
        conceptLabel.classList.remove('is-swapping');
      }, 420);
    }, 3800);
  }

  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>('.magnetic').forEach((button) => {
      button.addEventListener('pointermove', (event) => {
        const rect = button.getBoundingClientRect();
        button.style.transform = `translate(${(event.clientX - rect.left - rect.width / 2) * .06}px, ${(event.clientY - rect.top - rect.height / 2) * .1}px)`;
      });
      button.addEventListener('pointerleave', () => button.style.transform = '');
    });
  }
</script>

<style>
  .hero { position: relative; min-height: 100svh; overflow: hidden; padding-top: 6.5rem; background: radial-gradient(circle at 72% 35%,rgba(23,93,167,.16),transparent 25rem),linear-gradient(180deg,var(--ink),#0c182a 82%,var(--ink)); }
  .research-field, .hero-grid { position: absolute; inset: 0; width: 100%; height: 100%; }
  .research-field { opacity: .7; }
  .hero-grid { opacity: .32; }
  .hero-orbit { position: absolute; border: 1px solid rgba(71,167,225,.1); border-radius: 50%; }
  .orbit-a { width: 43rem; height: 43rem; right: -8rem; top: 4rem; }
  .hero-layout { position: relative; z-index: 2; display: grid; min-height: calc(100svh - 18rem); grid-template-columns: minmax(0,1.35fr) minmax(19rem,.65fr); align-items: center; gap: clamp(2rem,6vw,7rem); }
  .hero-copy { padding-block: 2rem 3rem; }
  .hero-eyebrow { margin-bottom: clamp(1.8rem,4.5vh,3.8rem); color: var(--muted); font-family: ui-monospace,monospace; font-size: clamp(.75rem,.85vw,.83rem); line-height: 1.9; letter-spacing: .04em; }
  h1 { display: grid; margin: 0; font-size: clamp(4.2rem,10.4vw,10.5rem); font-weight: 600; letter-spacing: -.075em; line-height: .72; }
  h1 span:nth-child(2) { color: transparent; -webkit-text-stroke: 1.2px rgba(230,242,255,.72); }
  h1 span:nth-child(3) { color: #b8c6d9; font-size: .52em; letter-spacing: .18em; line-height: 1.5; }
  .hero-role { margin-top: clamp(1.8rem,4.5vh,3.4rem); color: #d8e3f1; font-size: clamp(.92rem,1.5vw,1.15rem); font-weight: 500; }
  .hero-statement { max-width: 44rem; margin-top: 1rem; color: var(--muted); font-size: clamp(1rem,1.4vw,1.2rem); line-height: 1.75; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 2.2rem; }
  .hero-social { display: flex; flex-wrap: wrap; gap: .9rem 1.3rem; margin-top: 2rem; }
  .hero-social a { color: #8091a8; font-family: ui-monospace,monospace; font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; transition: color .2s ease; }
  .hero-social a:hover { color: var(--cyan); }
  .portrait-stage { position: relative; align-self: center; width: min(100%,23rem); justify-self: end; }
  .portrait-frame { position: relative; aspect-ratio: 4/5.4; overflow: hidden; clip-path: polygon(8% 0,100% 0,100% 92%,92% 100%,0 100%,0 8%); background: #111a27; }
  .portrait-frame::after { position: absolute; inset: 0; content: ''; background: linear-gradient(130deg,transparent 55%,rgba(50,199,255,.07)),linear-gradient(to top,rgba(5,8,16,.5),transparent 38%); }
  .portrait-frame img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; filter: grayscale(.85) contrast(1.04) saturate(.7); transition: filter .8s ease, transform 1.2s ease; }
  .portrait-stage:hover img { filter: grayscale(0) contrast(1.02) saturate(.9); transform: scale(1.012); }
  .portrait-mind { position: absolute; z-index: 3; inset: 0; pointer-events: none; opacity: .62; transition: opacity .7s ease; }
  .portrait-stage:hover .portrait-mind { opacity: .95; }
  .mind-map { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .mind-path, .mind-echo { fill: none; vector-effect: non-scaling-stroke; }
  .mind-path { stroke: rgba(124,245,204,.4); stroke-width: .8; stroke-linecap: round; stroke-dasharray: 2 9; animation: concept-flow 18s linear infinite; }
  .mind-path-b, .mind-path-d { stroke: rgba(50,199,255,.4); animation-direction: reverse; animation-duration: 22s; }
  .mind-path-c { animation-duration: 25s; }
  .mind-echo { stroke: rgba(147,202,239,.18); stroke-width: .55; stroke-dasharray: 1 5; }
  .node-orbit { fill: rgba(9,21,36,.18); stroke: rgba(124,245,204,.3); stroke-width: .6; transform-box: fill-box; transform-origin: center; animation: idea-breathe 5.4s ease-in-out infinite; }
  .node-b .node-orbit, .node-d .node-orbit { animation-delay: -2.4s; }
  .node-core { fill: var(--mint); filter: drop-shadow(0 0 3px rgba(124,245,204,.6)); }
  .node-b .node-core, .node-c .node-core { fill: var(--cyan); filter: drop-shadow(0 0 3px rgba(50,199,255,.6)); }
  .mind-dot { fill: rgba(213,239,255,.5); }
  .mind-label { position: absolute; right: 5%; top: 17%; display: inline-flex; align-items: center; gap: .35rem; border: 1px solid rgba(130,197,232,.18); padding: .34rem .48rem; background: rgba(8,19,33,.55); color: #bcd2e5; font-family: ui-monospace,monospace; font-size: .75rem; letter-spacing: .12em; line-height: 1; white-space: nowrap; backdrop-filter: blur(5px); transition: opacity .4s ease, transform .4s ease; }
  .mind-label::before { width: .25rem; height: .25rem; border-radius: 50%; background: var(--mint); box-shadow: 0 0 .4rem rgba(124,245,204,.55); content: ''; }
  .mind-label.is-swapping { opacity: 0; transform: translateY(-.25rem); }
  .portrait-caption { margin-top: .6rem; color: #8ba0b8; font-family: ui-monospace,monospace; font-size: .75rem; letter-spacing: .1em; text-align: right; }
  .expertise-strip { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(5,1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin-top: clamp(2rem,5vh,4rem); }
  .expertise-cell { position: relative; min-height: 9.5rem; border-right: 1px solid var(--line); padding: 1.15rem 1.1rem 1.4rem; transition: background .35s ease; }
  .expertise-cell::before { position: absolute; left: 0; top: -1px; width: 0; height: 2px; content: ''; background: linear-gradient(90deg,var(--mint),var(--cyan)); transition: width .55s cubic-bezier(.2,.8,.2,1); }
  .expertise-cell:hover::before { width: 100%; }
  .expertise-cell:hover { background: linear-gradient(180deg,rgba(124,245,204,.05),transparent); }
  .expertise-cell:last-child { border-right: 0; }
  .expertise-title { color: var(--mint); font-family: ui-monospace,monospace; font-size: clamp(.75rem,.72vw,.79rem); font-weight: 600; letter-spacing: .09em; line-height: 1.6; }
  .expertise-detail { margin-top: .8rem; color: var(--muted); font-size: clamp(.81rem,.82vw,.9rem); line-height: 1.62; }
  @keyframes concept-flow { to { stroke-dashoffset: -66; } }
  @keyframes idea-breathe { 0%,100% { opacity: .45; transform: scale(.75); } 50% { opacity: 1; transform: scale(1.14); } }
  @media (prefers-reduced-motion: reduce) {
    .mind-path, .node-orbit, .mind-label { animation: none; }
  }
  @media (max-width: 1080px) {
    .expertise-strip { grid-template-columns: repeat(3,1fr); }
    .expertise-cell:nth-child(3) { border-right: 0; }
    .expertise-cell:nth-child(-n+3) { border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 900px) {
    .hero { padding-top: 7rem; }
    .hero-layout { min-height: auto; grid-template-columns: 1fr; gap: 2rem; }
    .hero-copy { padding-bottom: 0; }
    .portrait-stage { width: min(78vw,24rem); justify-self: center; margin-bottom: 2.5rem; }
    .portrait-caption { text-align: center; }
  }
  @media (max-width: 620px) {
    .expertise-strip { grid-template-columns: repeat(2,1fr); }
    .expertise-cell { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .expertise-cell:nth-child(2n) { border-right: 0; }
    .expertise-cell:last-child { border-bottom: 0; }
  }
  @media (max-width: 520px) {
    h1 { font-size: clamp(3.7rem,18vw,5.5rem); line-height: .76; }
    .hero-actions { display: grid; grid-template-columns: 1fr 1fr; }
    .hero-actions .btn-ghost { grid-column: span 2; }
    .portrait-stage { width: 92%; }
    .expertise-cell { min-height: 10.5rem; padding: 1rem .75rem 1.2rem; }
  }
</style>
