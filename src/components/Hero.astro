---
import profile from '../data/profile.json';
const base = import.meta.env.BASE_URL;
---

<section class="relative overflow-hidden bg-hero pt-28 text-white md:pt-32">
  <div class="mx-auto grid min-h-[calc(100vh-6rem)] max-w-7xl items-center gap-12 px-5 pb-16 md:grid-cols-[1.15fr_0.85fr] md:px-8 md:pb-24">
    <div class="max-w-4xl animate-fade-in-up">
      <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-blue-300/25 bg-white/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.16em] text-blue-100 backdrop-blur">
        <span class="h-2 w-2 rounded-full bg-emerald-300"></span>
        Deep learning for breast imaging
      </div>

      <h1 class="text-5xl font-bold tracking-tight text-white md:text-7xl lg:text-8xl">
        {profile.name}
      </h1>

      <p class="mt-7 max-w-3xl text-lg leading-8 text-blue-50/85 md:text-2xl md:leading-10">
        {profile.title.trim()} specializing in medical imaging, mammography, breast MRI, and multimodal vision-language models.
      </p>

      <div class="mt-8 grid max-w-3xl gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {profile.proof.map((item) => (
          <div class="rounded-lg border border-white/10 bg-white/10 px-4 py-3 text-sm font-medium text-blue-50/90 backdrop-blur">
            {item}
          </div>
        ))}
      </div>

      <div class="mt-10 flex flex-wrap gap-4">
        <a href={`${base}publications/`} class="rounded-md bg-white px-5 py-3 text-sm font-bold text-slate-950 transition hover:bg-blue-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950">
          View publications
        </a>
        <a href={`${base}#contact`} class="rounded-md border border-white/20 px-5 py-3 text-sm font-bold text-white transition hover:border-blue-200 hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950">
          Contact
        </a>
        <a href={`${base}CV.pdf`} class="rounded-md border border-white/20 px-5 py-3 text-sm font-bold text-white transition hover:border-blue-200 hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950">
          CV
        </a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-sm pb-8 md:max-w-md md:pb-0">
      <div class="rounded-lg border border-white/15 bg-white/10 p-3 shadow-2xl shadow-slate-950/40 backdrop-blur">
        <img
          src={`${base}profile_photo.jpg`}
          alt={profile.name}
          class="aspect-[4/5] w-full rounded-md object-cover object-top"
          loading="eager"
        />
        <div class="mt-3 rounded-md bg-slate-950/80 p-4 text-sm text-blue-50/85">
          <p class="font-semibold text-white">PhD Researcher, FAU Pattern Recognition Lab</p>
          <p class="mt-1">{profile.location}</p>
        </div>
      </div>
    </div>
  </div>
</section>

