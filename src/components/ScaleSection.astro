---
const workload = [
  { label: 'DATA', sub: 'curate · shard' },
  { label: 'TRAIN', sub: 'distributed GPU' },
  { label: 'SERVE', sub: 'optimized inference' },
  { label: 'APPLY', sub: 'agents · software' },
];
---

<section id="scale" class="section-shell scale-section section-rule" aria-labelledby="scale-title">
  <div class="scale-grid grid-field" aria-hidden="true"></div>
  <div class="shell">
    <div class="scale-head reveal">
      <div>
        <p class="section-kicker">04 / COMPUTE</p>
        <h2 id="scale-title" class="section-title">RESEARCH THAT SCALES</h2>
      </div>
      <div>
        <p class="section-copy" data-research-copy>At NHR@FAU, research moves across the full compute path—from multimodal model development to training and inference on GPU clusters and supercomputing infrastructure.</p>
        <p class="section-copy" data-recruiter-copy>Production-minded AI engineering across distributed training, GPU infrastructure, model serving, agentic applications, and partner-facing research software.</p>
      </div>
    </div>

    <div class="compute-system reveal" aria-label="Distributed AI workload diagram">
      <div class="compute-rail" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="compute-origin">
        <span class="mono-label">ORCHESTRATOR</span>
        <strong>SLURM</strong>
        <small>schedule / monitor / reproduce</small>
      </div>
      <div class="gpu-cluster">
        {Array.from({ length: 8 }).map((_, index) => (
          <div class={`gpu-node node-${index + 1}`}>
            <span>GPU {String(index + 1).padStart(2, '0')}</span>
            <div>{Array.from({ length: 12 }).map(() => <i></i>)}</div>
            <small>{index < 4 ? 'TRAIN' : 'INFER'}</small>
          </div>
        ))}
      </div>
      <div class="model-endpoint">
        <div class="endpoint-core"><span>FM</span></div>
        <p>MODEL ENDPOINT</p><small>LLM · VLM · MULTIMODAL</small>
      </div>
    </div>

    <div class="workload-flow reveal">
      {workload.map((item, index) => (
        <div class="workload-step">
          <span>0{index + 1}</span><strong>{item.label}</strong><small>{item.sub}</small>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .scale-section { overflow: hidden; background: radial-gradient(circle at 50% 58%,rgba(30,99,182,.16),transparent 36rem),var(--ink); }
  .scale-grid { position: absolute; inset: 0; opacity: .3; }
  .scale-head { position: relative; display: grid; grid-template-columns: 1.1fr .9fr; align-items: end; gap: 4rem; }
  [data-recruiter-copy] { display: none; }
  :global(body[data-mode='recruiter']) [data-research-copy] { display: none; }
  :global(body[data-mode='recruiter']) [data-recruiter-copy] { display: block; }
  .compute-system { position: relative; display: grid; min-height: 30rem; grid-template-columns: 13rem 1fr 13rem; align-items: center; gap: 3rem; margin-top: clamp(4rem,8vw,8rem); }
  .compute-rail { position: absolute; z-index: 0; left: 11%; right: 11%; top: 50%; height: 1px; background: linear-gradient(90deg,var(--cyan),var(--blue),var(--mint)); box-shadow: 0 0 1rem rgba(50,199,255,.4); }
  .compute-rail i { position: absolute; width: .45rem; height: .45rem; margin-top: -.2rem; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 1rem var(--cyan); animation: packet 4s linear infinite; }
  .compute-rail i:nth-child(2) { animation-delay: -1.3s; }.compute-rail i:nth-child(3) { animation-delay: -2.6s; }
  .compute-origin, .model-endpoint { position: relative; z-index: 1; border: 1px solid var(--line-bright); background: rgba(17,31,51,.92); padding: 1.25rem; box-shadow: 0 0 2rem rgba(36,124,255,.1); }
  .compute-origin { display: grid; gap: .6rem; }
  .compute-origin strong { font-family: Outfit,sans-serif; font-size: 2rem; }
  .compute-origin small, .model-endpoint small { color: var(--muted); font-family: ui-monospace,monospace; font-size: .56rem; }
  .gpu-cluster { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(4,1fr); gap: .7rem; padding: 2.5rem; border: 1px solid var(--line); background: rgba(17,31,51,.9); }
  .gpu-cluster::before { position: absolute; left: 1rem; top: .8rem; content: 'NHR@FAU / DISTRIBUTED COMPUTE FABRIC'; color: #61758e; font-family: ui-monospace,monospace; font-size: .52rem; letter-spacing: .12em; }
  .gpu-node { min-width: 0; border: 1px solid #253750; background: #0b1524; padding: .6rem; transition: border-color .3s ease,transform .3s ease; }
  .gpu-node:hover { border-color: var(--cyan); transform: translateY(-3px); }
  .gpu-node > span, .gpu-node > small { display: block; color: #778ca5; font-family: ui-monospace,monospace; font-size: .48rem; }
  .gpu-node div { display: grid; grid-template-columns: repeat(4,1fr); gap: 2px; margin-block: .6rem; }
  .gpu-node i { aspect-ratio: 1; background: #1a3e5a; animation: pulse-node 2.8s ease-in-out infinite; animation-delay: calc(var(--node, 1) * -.2s); }
  .gpu-node i:nth-child(3n) { background: #256d8b; }
  .model-endpoint { text-align: center; }
  .endpoint-core { display: grid; width: 5rem; aspect-ratio: 1; place-items: center; margin: 0 auto 1rem; border: 1px solid var(--mint); border-radius: 50%; box-shadow: inset 0 0 2rem rgba(124,245,204,.08),0 0 2rem rgba(124,245,204,.08); }
  .endpoint-core span { color: var(--mint); font-family: ui-monospace,monospace; font-size: 1.25rem; }
  .model-endpoint p { font-size: .7rem; font-weight: 700; }
  .workload-flow { display: grid; grid-template-columns: repeat(4,1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .workload-step { display: grid; grid-template-columns: auto 1fr; gap: .25rem .8rem; border-right: 1px solid var(--line); padding: 1.2rem; }
  .workload-step:last-child { border-right: 0; }
  .workload-step > span { grid-row: span 2; color: var(--cyan); font-family: ui-monospace,monospace; font-size: .55rem; }
  .workload-step strong { font-size: .78rem; }.workload-step small { color: var(--muted); font-size: .65rem; }
  @keyframes packet { from { left: 0; } to { left: 100%; } }
  @keyframes pulse-node { 50% { opacity: .35; } }
  @media (max-width: 900px) {
    .scale-head { grid-template-columns: 1fr; }
    .compute-system { grid-template-columns: 1fr; gap: 1.5rem; }
    .compute-rail { left: 50%; right: auto; top: 10%; bottom: 10%; width: 1px; height: auto; }
    .compute-origin, .model-endpoint { width: min(100%,15rem); justify-self: center; }
  }
  @media (max-width: 600px) { .gpu-cluster { grid-template-columns: repeat(2,1fr); padding: 2.4rem 1rem 1rem; } .workload-flow { grid-template-columns: repeat(2,1fr); } .workload-step:nth-child(2) { border-right: 0; }.workload-step:nth-child(-n+2) { border-bottom: 1px solid var(--line); } }
</style>
