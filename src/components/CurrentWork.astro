---
import current from '../data/current.json';
---

<section id="now" class="section-shell now-section section-rule" aria-labelledby="now-title">
  <div class="shell now-layout">
    <div class="now-heading reveal">
      <p class="section-kicker">07 / LIVE STATE</p>
      <h2 id="now-title" class="section-title">NOW / CURRENTLY BUILDING</h2>
      <p class="section-copy">A public snapshot of active themes. This section is intentionally data-driven so the current state can evolve without redesigning the page.</p>
    </div>
    <div class="now-feed reveal">
      <div class="feed-status"><span></span>PUBLIC RESEARCH FEED <b>UPDATED / 2026</b></div>
      {current.map((item, index) => (
        <article>
          <span class="feed-index">0{index + 1}</span>
          <div><p>{item.type}</p><h3>{item.title}</h3><small>{item.description}</small></div>
          <b>{item.status}</b>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .now-section { background: #07101b; }
  .now-layout { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem,8vw,8rem); }
  .now-heading { position: sticky; top: 8rem; align-self: start; }.now-heading .section-title { font-size: clamp(2.6rem,5vw,5.8rem); }.now-heading .section-copy { margin-top: 2rem; }
  .now-feed { border-top: 1px solid var(--line); }
  .feed-status { display: flex; align-items: center; gap: .6rem; padding: .9rem 0; color: #7287a0; font-family: ui-monospace,monospace; font-size: .55rem; letter-spacing: .09em; }
  .feed-status span { width: .45rem; height: .45rem; border-radius: 50%; background: var(--mint); box-shadow: 0 0 .8rem var(--mint); animation: status 2s ease-in-out infinite; }.feed-status b { margin-left: auto; font-weight: 500; }
  .now-feed article { display: grid; grid-template-columns: 2.5rem 1fr auto; gap: 1rem; border-top: 1px solid var(--line); padding: 1.8rem 0; }
  .feed-index { color: #536a83; font-family: ui-monospace,monospace; font-size: .56rem; }.now-feed article p { color: var(--cyan); font-family: ui-monospace,monospace; font-size: .55rem; letter-spacing: .1em; text-transform: uppercase; }
  .now-feed h3 { margin-top: .5rem; font-size: clamp(1.4rem,2.5vw,2.1rem); font-weight: 500; letter-spacing: -.025em; }.now-feed small { display: block; max-width: 37rem; margin-top: .8rem; color: var(--muted); font-size: .78rem; line-height: 1.7; }
  .now-feed article > b { align-self: start; border: 1px solid var(--line-bright); border-radius: 99px; padding: .32rem .55rem; color: var(--mint); font-family: ui-monospace,monospace; font-size: .48rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; }
  @keyframes status { 50% { opacity: .35; } }
  @media (max-width: 800px) { .now-layout { grid-template-columns: 1fr; }.now-heading { position: static; }.now-feed article { grid-template-columns: 1.7rem 1fr; }.now-feed article > b { grid-column: 2; justify-self: start; } }
</style>
