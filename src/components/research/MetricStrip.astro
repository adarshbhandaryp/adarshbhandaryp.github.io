---
interface Metric { value: string; label: string; detail?: string; tone?: 'default' | 'positive' | 'caution'; }
interface Props { metrics: Metric[]; compact?: boolean; }
const { metrics, compact = false } = Astro.props;
---

<div class:list={['metric-strip', { compact }]} aria-label="Research evidence at a glance">
  {metrics.map((metric) => (
    <div class:list={['metric-cell', `tone-${metric.tone || 'default'}`]}>
      <strong>{metric.value}</strong>
      <span>{metric.label}</span>
      {metric.detail && <small>{metric.detail}</small>}
    </div>
  ))}
</div>

<style>
  .metric-strip { display: grid; grid-template-columns: repeat(auto-fit,minmax(10rem,1fr)); border: 1px solid var(--line); border-right: 0; background: var(--surface); box-shadow: 0 1.5rem 5rem rgba(1,6,14,.16); }
  .metric-cell { min-height: 9rem; border-right: 1px solid var(--line); padding: 1.35rem; }
  .metric-cell::before { display: block; width: 1.8rem; height: 2px; margin-bottom: 1.3rem; content: ''; background: var(--cyan); }
  .tone-positive::before { background: var(--mint); }.tone-caution::before { background: var(--amber); }
  strong { display: block; color: var(--text); font: 600 clamp(1.7rem,3vw,3rem)/1 Outfit,sans-serif; letter-spacing: -.04em; }
  span { display: block; margin-top: .7rem; color: var(--cyan); font: 600 .75rem ui-monospace,monospace; letter-spacing: .11em; text-transform: uppercase; }
  small { display: block; margin-top: .45rem; color: var(--muted); font-size: .78rem; line-height: 1.5; }
  .compact .metric-cell { min-height: 7.5rem; }
  @media (max-width: 560px) { .metric-strip { grid-template-columns: repeat(2,1fr); }.metric-cell { min-height: 8rem; padding: 1rem; } }
</style>
