---
interface Card { label: string; title: string; body: string; tone?: 'default' | 'positive' | 'caution'; }
interface Props { items: Card[]; }
const { items } = Astro.props;
---

<section id="summary" class="paper-takeaway" aria-labelledby="takeaway-title">
  <p>08 / 30-SECOND SUMMARY</p>
  <h2 id="takeaway-title">THE PAPER, END TO END</h2>
  <ol>
    {items.map((item, index) => <li><span>{item.label}</span><strong>{item.title}</strong><p>{item.body}</p>{index < items.length - 1 && <i aria-hidden="true">↓</i>}</li>)}
  </ol>
</section>

<style>
  .paper-takeaway { scroll-margin-top: 6.5rem; border-top: 1px solid var(--line); padding-block: clamp(5rem,9vw,9rem); }
  .paper-takeaway > p { color: var(--mint); font: .55rem ui-monospace,monospace; letter-spacing: .12em; }.paper-takeaway h2 { max-width: 13ch; margin-top: 1rem; font-size: clamp(2.8rem,6vw,6rem); font-weight: 500; letter-spacing: -.06em; line-height: .9; }
  ol { display: grid; margin-top: 4rem; border: 1px solid var(--line); background: #08111e; }li { position: relative; display: grid; grid-template-columns: 8rem minmax(12rem,.6fr) 1fr; gap: 1.5rem; align-items: center; min-height: 7rem; border-bottom: 1px solid var(--line); padding: 1.3rem 1.5rem; }li:last-child { border-bottom: 0; }li > span { color: var(--cyan); font: .55rem ui-monospace,monospace; letter-spacing: .1em; }li strong { font-size: 1.1rem; font-weight: 500; }li p { color: var(--muted); font-size: .76rem; line-height: 1.6; }li i { position: absolute; z-index: 2; left: 1.2rem; bottom: -.65rem; display: grid; width: 1.3rem; height: 1.3rem; place-items: center; border: 1px solid var(--line-bright); border-radius: 50%; background: #08111e; color: var(--mint); font: normal .7rem ui-monospace,monospace; }
  @media (max-width: 700px) { li { grid-template-columns: 1fr; gap: .6rem; padding: 1.3rem; } }
</style>
