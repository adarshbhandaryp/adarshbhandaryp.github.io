---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  inverse?: boolean;
}

const { eyebrow, title, description, inverse = false } = Astro.props;
---

<div class="mb-10 max-w-3xl md:mb-14">
  {eyebrow && <p class={inverse ? 'section-eyebrow text-blue-200' : 'section-eyebrow'}>{eyebrow}</p>}
  <h2 class={inverse ? 'mt-3 text-3xl font-bold tracking-tight text-white md:text-5xl' : 'mt-3 text-3xl font-bold tracking-tight text-slate-950 md:text-5xl'}>
    {title}
  </h2>
  {description && <p class={inverse ? 'mt-5 text-base leading-7 text-blue-100/80 md:text-lg' : 'mt-5 text-base leading-7 text-slate-600 md:text-lg'}>{description}</p>}
</div>
