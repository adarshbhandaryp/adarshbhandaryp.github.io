---
import system from '../data/aiSystems.json';
import current from '../data/current.json';
---

<section id="systems" class="section-shell ai-system-section section-rule" aria-labelledby="ai-system-title">
  <div class="system-grid grid-field" aria-hidden="true"></div>
  <div class="shell">
    <div class="system-heading reveal">
      <div>
        <p class="section-kicker">01 / AI SYSTEMS</p>
        <h2 id="ai-system-title" class="section-title">{system.title}</h2>
      </div>
      <div>
        <p class="system-statement">{system.statement}</p>
        <p class="system-note"><span aria-hidden="true"></span>{system.privacyNote}</p>
      </div>
    </div>

    <ol class="system-chain" data-stagger="70" aria-label="Applied GenAI system chain">
      {system.chain.map((stage, index) => (
        <li style={`--i:${index}`}>
          <i class="chain-flow" aria-hidden="true"></i>
          <span class="chain-index">{String(index + 1).padStart(2, '0')}</span>
          <strong>{stage.label}</strong>
          <small>{stage.detail}</small>
        </li>
      ))}
    </ol>

    <div class="system-stack reveal">
      {system.stack.map((group) => (
        <article>
          <h3>{group.group}</h3>
          <div class="chip-set">{group.items.map((item) => <span class="chip">{item}</span>)}</div>
        </article>
      ))}
    </div>

    <div class="system-proof reveal">
      <p class="mono-label">WHAT I AM WORKING ON NOW</p>
      <div>
        {current.map((item) => (
          <article>
            <span>{item.type}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .ai-system-section { overflow: hidden; background: radial-gradient(circle at 50% 45%,rgba(36,124,255,.1),transparent 32rem),var(--ink); }
  .system-grid { position: absolute; inset: 0; opacity: .2; }
  .system-heading { position: relative; display: grid; grid-template-columns: 1.05fr .95fr; align-items: end; gap: clamp(2rem,7vw,7rem); }
  .system-heading .section-title { max-width: 12ch; }
  .system-statement { max-width: 44rem; color: #d7e3f1; font-size: clamp(1.05rem,1.7vw,1.4rem); line-height: 1.7; }
  .system-note { display: flex; align-items: center; gap: .55rem; margin-top: 1.3rem; color: #8ba0b8; font-family: ui-monospace,monospace; font-size: .75rem; letter-spacing: .06em; }
  .system-note span { flex: 0 0 auto; width: .4rem; height: .4rem; border-radius: 50%; background: var(--mint); }

  .system-chain { position: relative; display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); margin-top: clamp(3.5rem,7vw,6rem); border: 1px solid var(--line); background: rgba(17,31,51,.7); }
  .system-chain li { position: relative; min-width: 0; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 1.1rem 1.15rem 1.4rem; }
  .system-chain li:nth-child(4n) { border-right: 0; }
  .system-chain li:nth-child(n+5) { border-bottom: 0; }
  .system-chain li::before { position: absolute; z-index: 3; left: 0; top: 0; width: 0; height: 2px; content: ''; background: linear-gradient(90deg,var(--cyan),var(--mint)); transition: width .5s cubic-bezier(.2,.8,.2,1); }
  .system-chain li:hover::before { width: 100%; }
  .system-chain li:hover { background: linear-gradient(180deg,rgba(50,199,255,.06),transparent); }
  /* A light travels 01 → 08 to show the direction the chain runs in. */
  .chain-flow { position: absolute; z-index: 0; inset: 0; opacity: 0; background: radial-gradient(circle at 18% 0%,rgba(50,199,255,.2),transparent 68%); }
  .system-chain.is-visible .chain-flow { animation: chain-travel 5.6s ease-in-out infinite; animation-delay: calc(var(--i) * .28s); }
  .chain-index { position: relative; z-index: 1; color: #8ba0b8; font-family: ui-monospace,monospace; font-size: .75rem; }
  .system-chain strong { position: relative; z-index: 1; display: block; margin-top: 1.9rem; color: #e3ecf7; font-family: ui-monospace,monospace; font-size: clamp(.75rem,.8vw,.83rem); font-weight: 600; letter-spacing: .07em; line-height: 1.5; }
  .system-chain small { position: relative; z-index: 1; display: block; margin-top: .55rem; color: var(--muted); font-size: .81rem; line-height: 1.6; }
  .system-chain li:not(:nth-child(4n)):not(:last-child)::after { position: absolute; z-index: 2; right: -.62rem; top: 50%; display: grid; width: 1.24rem; height: 1.24rem; place-items: center; border: 1px solid var(--line); border-radius: 50%; content: '→'; background: var(--ink); color: var(--cyan); font-size: .75rem; }

  .system-stack { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; margin-top: 2rem; border: 1px solid var(--line); background: var(--line); }
  .system-stack article { background: rgba(17,31,51,.7); padding: 1.15rem; }
  .system-stack h3 { color: var(--cyan); font-family: ui-monospace,monospace; font-size: .75rem; font-weight: 600; letter-spacing: .12em; }
  .system-stack .chip-set { margin-top: 1rem; }

  .system-proof { margin-top: clamp(3rem,6vw,5rem); }
  .system-proof > div { display: grid; grid-template-columns: repeat(4,1fr); margin-top: 1rem; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .system-proof article { border-right: 1px solid var(--line); padding: 1.3rem; }
  .system-proof article:last-child { border-right: 0; }
  .system-proof article > span { color: var(--mint); font-family: ui-monospace,monospace; font-size: .75rem; text-transform: uppercase; }
  .system-proof h3 { margin-top: .65rem; font-size: 1rem; font-weight: 500; }
  .system-proof article p { margin-top: .7rem; color: var(--muted); font-size: .83rem; line-height: 1.65; }

  @keyframes chain-travel {
    0%, 100% { opacity: 0; }
    8% { opacity: 1; }
    26% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chain-flow { animation: none !important; opacity: 0; }
  }

  @media (max-width: 900px) {
    .system-heading { grid-template-columns: 1fr; }
    .system-chain { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .system-chain li { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .system-chain li:nth-child(2n) { border-right: 0; }
    .system-chain li:nth-child(n+7) { border-bottom: 0; }
    .system-chain li::after { display: none !important; }
    .system-stack { grid-template-columns: repeat(2,1fr); }
    .system-proof > div { grid-template-columns: repeat(2,1fr); }
    .system-proof article:nth-child(2) { border-right: 0; }
    .system-proof article:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 520px) {
    .system-chain, .system-stack, .system-proof > div { grid-template-columns: 1fr; }
    .system-chain li { border-right: 0; border-bottom: 1px solid var(--line); }
    .system-chain li:last-child { border-bottom: 0; }
    .system-stack article { padding: 1rem; }
    .system-proof article { border-right: 0; border-bottom: 1px solid var(--line); }
  }
</style>
