---
import { externalPublicationLinks, getPublications, getPublicationUrl } from '../utils/publications';
import { sitePath } from '../utils/site';

const all = await getPublications();

const storySpecs = [
  {
    slug: 'attention-guided-erasing-transfer-learning-breast-abnormality',
    label: 'SELF-SUPERVISED REPRESENTATION LEARNING',
  },
  {
    slug: 'mammoblip-mammography-report-generation',
    label: 'VISION-LANGUAGE MODELS',
  },
  {
    slug: 'be-wise-breast-mri-explanation',
    label: 'WEAK SUPERVISION + EXPLAINABILITY',
  },
  {
    slug: 'dataset-informed-transfer-learning-framework',
    label: 'ADAPTIVE TRAINING OBJECTIVES',
  },
];

const stories = storySpecs.map((spec) => {
  const publication = all.find((entry) => entry.slug === spec.slug);
  if (!publication) return null;
  return {
    ...spec,
    publication,
    links: externalPublicationLinks(publication),
    figure: publication.data.story?.heroFigure ?? null,
    summary: publication.data.plainLanguageSummary,
  };
}).filter(Boolean);
---

<section id="research" class="section-shell research-stories section-rule" aria-labelledby="research-title">
  <div class="shell">
    <div class="story-intro reveal">
      <div>
        <p class="section-kicker">03 / FEATURED RESEARCH</p>
        <h2 id="research-title" class="section-title">FOUR PIECES OF WORK</h2>
      </div>
      <p class="section-copy">Chosen because they demonstrate different things: learning representations without labels, generating language from images, supervising a 3D model from one annotated slice, and letting a dataset shape its own training objective. The full record is in the archive.</p>
    </div>

    <div class="story-list">
      {stories.map((story, index) => story && (
        <article class="research-story reveal">
          <div class="story-visual">
            {story.figure ? (
              <img
                src={story.figure.src}
                alt={story.figure.alt}
                width={story.figure.width}
                height={story.figure.height}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <p class="story-textonly">{story.publication.data.tags.slice(0, 2).join(' · ')}</p>
            )}
          </div>
          <div class="story-content">
            <p class="mono-label">{String(index + 1).padStart(2, '0')} / {story.label}</p>
            <h3><a href={getPublicationUrl(story.publication.slug)}>{story.publication.data.title}</a></h3>
            <p class="story-summary">{story.summary}</p>
            <div class="story-meta">
              <span>{story.publication.data.venue}</span>
              <span>{story.publication.data.year}</span>
              {story.publication.data.status && <span>{story.publication.data.status}</span>}
            </div>
            <div class="story-links">
              <a href={getPublicationUrl(story.publication.slug)} class="text-link">1 min read</a>
              {story.links.slice(0, 2).map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-link">{link.label}</a>)}
            </div>
          </div>
        </article>
      ))}
    </div>

    <a href={sitePath('publications/')} class="btn-secondary archive-link">Full publication archive <span aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  .research-stories { background: radial-gradient(circle at 92% 14%,rgba(36,124,255,.1),transparent 29rem),var(--ink); }
  .story-intro { display: grid; grid-template-columns: 1.05fr .95fr; align-items: end; gap: 3rem; }
  .story-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1px; margin-top: clamp(3.5rem,7vw,6rem); border: 1px solid var(--line); background: var(--line); }
  .research-story { display: grid; grid-template-rows: auto 1fr; background: var(--surface); }
  .story-visual { position: relative; display: flex; height: 15rem; align-items: center; justify-content: center; overflow: hidden; border-bottom: 1px solid var(--line); background: #eef3f5; padding: .8rem; }
  .story-visual img { max-width: 100%; max-height: 13.4rem; width: auto; height: auto; }
  .story-textonly { color: #4a6076; font-family: ui-monospace,monospace; font-size: .58rem; letter-spacing: .12em; text-transform: uppercase; }
  .story-content { padding: 1.4rem 1.5rem 1.6rem; }
  .story-content .mono-label { font-size: .5rem; letter-spacing: .12em; }
  .story-content h3 { margin-top: 1rem; font-size: clamp(1.15rem,1.9vw,1.55rem); font-weight: 500; letter-spacing: -.02em; line-height: 1.24; }
  .story-content h3 a:hover { color: var(--cyan); }
  .story-summary { margin-top: 1rem; color: var(--muted); font-size: .78rem; line-height: 1.72; }
  .story-meta { display: flex; flex-wrap: wrap; gap: .35rem 1rem; margin-top: 1.3rem; color: #8ba0b8; font-family: ui-monospace,monospace; font-size: .55rem; }
  .story-meta span + span::before { content: '·'; margin-right: 1rem; color: #8ba0b8; }
  .story-links { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 1.4rem; border-top: 1px solid var(--line); padding-top: 1.1rem; }
  .story-links .text-link { font-size: .72rem; }
  .archive-link { margin-top: 2.5rem; }
  @media (max-width: 860px) {
    .story-intro, .story-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .story-visual { height: 11.5rem; }
    .story-visual img { max-height: 9.9rem; }
  }
</style>
