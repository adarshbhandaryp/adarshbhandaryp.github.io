---
import { externalPublicationLinks, getPublications, getPublicationUrl, publicationMetaParts } from '../utils/publications';
import { sitePath } from '../utils/site';

const all = await getPublications();

const storySpecs = [
  {
    slug: 'attention-guided-erasing-transfer-learning-breast-abnormality',
    label: 'SELF-SUPERVISED REPRESENTATION LEARNING',
  },
  {
    slug: 'mammoblip-mammography-report-generation',
    label: 'VISION-LANGUAGE MODELS',
  },
  {
    slug: 'be-wise-breast-mri-explanation',
    label: 'WEAK SUPERVISION + EXPLAINABILITY',
  },
  {
    slug: 'dataset-informed-transfer-learning-framework',
    label: 'ADAPTIVE TRAINING OBJECTIVES',
  },
];

/** First sentence only — the full summary lives on the publication page. */
function firstSentence(text: string) {
  const match = text.match(/^[\s\S]*?[.!?](?=\s|$)/);
  return (match ? match[0] : text).trim();
}

const stories = storySpecs.map((spec) => {
  const publication = all.find((entry) => entry.slug === spec.slug);
  if (!publication) return null;
  const story = publication.data.story;
  const signals = story?.signalStats ?? [];
  /* Lead with the reported outcomes, then fall back to scale figures. */
  const stats = [...signals.filter((stat) => stat.tone === 'positive'), ...signals.filter((stat) => stat.tone !== 'positive')].slice(0, 2);
  return {
    ...spec,
    publication,
    links: externalPublicationLinks(publication),
    figure: story?.heroFigure ?? null,
    summary: firstSentence(story?.storyIntro ?? publication.data.plainLanguageSummary),
    stats,
  };
}).filter(Boolean);
---

<section id="research" class="section-shell research-stories section-rule" aria-labelledby="research-title">
  <div class="shell">
    <div class="story-intro reveal">
      <div>
        <p class="section-kicker">03 / FEATURED RESEARCH</p>
        <h2 id="research-title" class="section-title">FOUR PIECES OF WORK</h2>
      </div>
      <p class="section-copy">Learning representations without labels, generating language from images, supervising a 3D model from one annotated slice, and letting a dataset shape its own training objective.</p>
    </div>

    <div class="story-list" data-stagger-each="2">
      {stories.map((story, index) => story && (
        <article class="research-story">
          <div class="story-visual">
            {story.figure ? (
              <img
                src={story.figure.src}
                alt={story.figure.alt}
                width={story.figure.width}
                height={story.figure.height}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <p class="story-textonly">{story.publication.data.tags.slice(0, 2).join(' · ')}</p>
            )}
            <span class="story-sweep" aria-hidden="true"></span>
          </div>
          <div class="story-content">
            <p class="mono-label">{String(index + 1).padStart(2, '0')} / {story.label}</p>
            <h3><a href={getPublicationUrl(story.publication.slug)}>{story.publication.data.title}</a></h3>
            <p class="story-summary">{story.summary}</p>
            {story.stats.length > 0 && (
              <dl class="story-stats">
                {story.stats.map((stat) => (
                  <div>
                    <dt class="count-up" data-count={stat.value}>{stat.value}</dt>
                    <dd>{stat.label}</dd>
                  </div>
                ))}
              </dl>
            )}
            <div class="story-meta">
              {publicationMetaParts(story.publication).map((part) => <span>{part}</span>)}
            </div>
            <div class="story-links">
              <a href={getPublicationUrl(story.publication.slug)} class="text-link">1 min read</a>
              {story.links.slice(0, 2).map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-link">{link.label}</a>)}
            </div>
          </div>
        </article>
      ))}
    </div>

    <a href={sitePath('publications/')} class="btn-secondary archive-link">Full publication archive <span aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  .research-stories { background: radial-gradient(circle at 92% 14%,rgba(36,124,255,.1),transparent 29rem),var(--ink); }
  .story-intro { display: grid; grid-template-columns: 1.05fr .95fr; align-items: end; gap: 3rem; }
  .story-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1px; margin-top: clamp(3rem,6vw,5rem); border: 1px solid var(--line); background: var(--line); }
  .research-story { display: grid; grid-template-rows: auto 1fr; background: var(--surface); transition: background .35s ease; }
  .research-story:hover { background: #192c45; }
  .story-visual { position: relative; display: flex; height: 15rem; align-items: center; justify-content: center; overflow: hidden; border-bottom: 1px solid var(--line); background: #eef3f5; padding: .8rem; }
  .story-visual img { max-width: 100%; max-height: 13.4rem; width: auto; height: auto; transition: transform .7s cubic-bezier(.2,.8,.2,1); }
  .research-story:hover .story-visual img { transform: scale(1.045); }
  .story-sweep { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(105deg,transparent 38%,rgba(255,255,255,.5) 50%,transparent 62%); transform: translateX(-110%); transition: transform .9s cubic-bezier(.2,.8,.2,1); }
  .research-story:hover .story-sweep { transform: translateX(110%); }
  .story-textonly { color: #4a6076; font-family: ui-monospace,monospace; font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; }
  .story-content { padding: 1.4rem 1.5rem 1.6rem; }
  .story-content .mono-label { font-size: .75rem; letter-spacing: .12em; }
  .story-content h3 { margin-top: 1rem; font-size: clamp(1.15rem,1.9vw,1.55rem); font-weight: 500; letter-spacing: -.02em; line-height: 1.24; }
  .story-content h3 a:hover { color: var(--cyan); }
  .story-summary { margin-top: .9rem; color: var(--muted); font-size: .92rem; line-height: 1.7; }
  .story-stats { display: flex; flex-wrap: wrap; gap: .5rem 2.2rem; margin-top: 1.2rem; border-top: 1px solid var(--line); padding-top: 1.1rem; }
  .story-stats dt { color: var(--mint); font-family: Outfit,sans-serif; font-size: clamp(1.4rem,2.2vw,1.85rem); font-weight: 600; letter-spacing: -.03em; line-height: 1; }
  .story-stats dd { margin-top: .35rem; max-width: 14rem; color: #8ba0b8; font-family: ui-monospace,monospace; font-size: .75rem; letter-spacing: .04em; line-height: 1.45; text-transform: uppercase; }
  .story-meta { display: flex; flex-wrap: wrap; gap: .35rem 1rem; margin-top: 1.2rem; color: #8ba0b8; font-family: ui-monospace,monospace; font-size: .75rem; }
  .story-meta span + span::before { content: '·'; margin-right: 1rem; color: #8ba0b8; }
  .story-links { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 1.4rem; border-top: 1px solid var(--line); padding-top: 1.1rem; }
  .story-links .text-link { font-size: .85rem; }
  .archive-link { margin-top: 2.5rem; }
  @media (max-width: 860px) {
    .story-intro, .story-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .story-visual { height: 11.5rem; }
    .story-visual img { max-height: 9.9rem; }
  }
</style>
