---
import '../styles/global.css';
import profile from '../data/profile.json';
import { sitePath } from '../utils/site';

interface Props {
	title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = `${profile.name} | Research Scientist`,
  description = profile.tagline,
  image = sitePath('profile_photo.webp'),
  type = 'website',
  jsonLd,
} = Astro.props;
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site || Astro.url).toString();
const absoluteImage = new URL(image, Astro.site || Astro.url).toString();
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: 'Adarsh Panambur',
  url: new URL(sitePath(), Astro.site || Astro.url).toString(),
  image: new URL(sitePath('profile_photo.webp'), Astro.site || Astro.url).toString(),
  jobTitle: 'Research Scientist',
  description: profile.title,
  affiliation: [
    { '@type': 'Organization', name: 'Erlangen National High Performance Computing Center (NHR@FAU)' },
    { '@type': 'Organization', name: 'Pattern Recognition Lab, Friedrich-Alexander-Universitat Erlangen-Nurnberg' },
  ],
  homeLocation: { '@type': 'Place', name: profile.location },
  sameAs: [profile.scholar, profile.github, profile.linkedin],
  knowsAbout: [
    'Self-supervised learning',
    'Vision-language models',
    'Large language models',
    'Multimodal AI',
    'Foundation models',
    'Medical imaging',
    'Mammography',
    'Breast MRI',
    'Explainable AI',
    'GPU inference',
    'High-performance computing',
  ],
};
const structuredData = jsonLd ? [personJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])] : [personJsonLd];
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0a1424" />
		<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
		<link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
    <link rel="sitemap" type="application/xml" href={sitePath('sitemap.xml')} />
    <link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:site_name" content={profile.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body class="bg-primary text-text">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot />
	</body>
</html>
