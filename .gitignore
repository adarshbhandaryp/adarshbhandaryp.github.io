# Dependencies and Astro build output
node_modules/
dist/
.astro/

# Local environment files
.env
.env.*
!.env.example

# Logs and package-manager diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary tools and generated working files
tmp/
temp/
.codex-node-*

# LaTeX/PDF build intermediates (keep final PDFs)
output/pdf/*.aux
output/pdf/*.fdb_latexmk
output/pdf/*.fls
output/pdf/*.out
output/pdf/*.synctex.gz
output/pdf/*.toc

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
